---
interface Props {
  counterId?: string;
}

const { counterId } = Astro.props;
---

{
  counterId && (
    <section
      class="cookie-consent"
      data-cookie-consent
      data-counter-id={counterId}
      aria-labelledby="cookie-consent-title"
      hidden
    >
      <div class="cookie-consent__copy">
        <h2 id="cookie-consent-title">Аналитика сайта</h2>
        <p>
          С вашего разрешения используем Яндекс Метрику, чтобы понимать, как пользуются сайтом.
          Без согласия аналитика отключена. <a href="/privacy/">Подробнее</a>
        </p>
      </div>
      <div class="cookie-consent__actions">
        <button type="button" data-cookie-allow>Разрешить</button>
        <button type="button" data-cookie-deny>Отказаться</button>
      </div>
    </section>
  )
}

<script>
  import { initAnalyticsConsent } from '@/lib/analytics-consent';

  const cleanup = initAnalyticsConsent(document);
  if (import.meta.hot) import.meta.hot.dispose(cleanup);
</script>

<style>
  .cookie-consent {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    z-index: 100;
    display: grid;
    width: min(calc(100% - 2rem), 58rem);
    gap: 1rem;
    margin-inline: auto;
    border: 1px solid rgb(59 38 39 / 18%);
    border-radius: 0.75rem;
    background: var(--surface-elevated);
    box-shadow: 0 0.75rem 2.5rem rgb(59 38 39 / 18%);
    padding: 1rem;
    color: var(--text-primary);
  }

  .cookie-consent[hidden] {
    display: none;
  }

  .cookie-consent h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
  }

  .cookie-consent p {
    margin: 0.35rem 0 0;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .cookie-consent a {
    color: inherit;
    text-underline-offset: 0.2em;
  }

  .cookie-consent__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.625rem;
  }

  .cookie-consent button {
    min-height: 2.75rem;
    border: 1px solid var(--text-primary);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--text-primary);
    padding: 0.625rem 1rem;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .cookie-consent button:first-child {
    background: var(--text-primary);
    color: var(--surface-elevated);
  }

  @media (min-width: 48rem) {
    .cookie-consent {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      padding: 1.125rem 1.25rem;
    }

    .cookie-consent__actions {
      min-width: 17rem;
    }
  }
</style>
