---
import { Image } from 'astro:assets';
import ActionLink from '@/components/ActionLink.astro';
import { ASSORTMENT } from '@/lib/assortment';
import { getProductWhatsAppUrl, HOME_SECTION_IDS } from '@/lib/site';
---

<section id={HOME_SECTION_IDS.assortment} class="assortment" aria-labelledby="assortment-title">
  <cake-carousel class="assortment__carousel" aria-labelledby="assortment-title">
    <h2 id="assortment-title" class="assortment__title">Торты и десерты</h2>

    <div class="assortment__media" data-media-deck>
      {ASSORTMENT.map((product, index) => (
        <button class="assortment__photo" type="button" data-photo data-index={index}>
          <Image
            src={product.image}
            widths={[240, 400, 600, 800]}
            sizes="(max-width: 639px) 65vw, (max-width: 1023px) 397px, 400px"
            format="webp"
            alt={product.alt}
            loading="lazy"
            draggable="false"
          />
        </button>
      ))}
    </div>

    <nav class="assortment__controls" aria-label="Переключение десертов">
      <button type="button" data-direction="-1" aria-label="Предыдущий десерт">←</button>
      <span data-counter aria-hidden="true">01 / {String(ASSORTMENT.length).padStart(2, '0')}</span>
      <button type="button" data-direction="1" aria-label="Следующий десерт">→</button>
    </nav>

    <div id="assortment-products" class="assortment__panels" data-content-deck>
      {ASSORTMENT.map((product) => (
        <article class="assortment__panel" data-product data-panel data-name={product.name} aria-labelledby={`assortment-${product.id}-title`}>
          <div class="assortment__description">
            <h3 id={`assortment-${product.id}-title`}>{product.name}</h3>
            <p>{product.description}</p>
          </div>
          <details class="assortment__ingredients" open>
            <summary>Состав:<span aria-hidden="true">+</span></summary>
            <p>{product.ingredients ?? 'Состав этого десерта уточните у пекарни по телефону или в WhatsApp.'}</p>
          </details>
          <p class="assortment__highlight">{product.highlight}</p>
          <ActionLink variant="primary" href={getProductWhatsAppUrl(product.name)} target="_blank" rel="noopener noreferrer">
            Узнать цену и наличие
          </ActionLink>
        </article>
      ))}
    </div>

    <p class="sr-only" data-announcement aria-live="polite" aria-atomic="true"></p>
  </cake-carousel>
</section>

<script>
  import { CakeCarousel } from '@/lib/cake-carousel';
  if (!customElements.get('cake-carousel')) customElements.define('cake-carousel', CakeCarousel);
</script>

<style>
  .assortment { padding-block: clamp(3.5rem, 7vw, 6.5rem); overflow: clip; }
  .assortment__carousel { display: block; width: min(calc(100% - 2.5rem), 77.5rem); margin-inline: auto; }
  .assortment__title { width: fit-content; max-width: 100%; margin: 0 0 2rem; padding: 0.6rem 1.25rem; background: var(--text-primary); color: white; font: 400 clamp(1.875rem, 4.5vw, 3rem)/1.08 'Vetrino', Georgia, serif; text-wrap: balance; }
  .assortment__media { display: grid; gap: 1rem; }
  .assortment__photo { width: min(100%, 24rem); aspect-ratio: 397 / 492; margin-inline: auto; padding: 0; border: 0; border-radius: 0.75rem; overflow: hidden; background: #e6d5bd; }
  .assortment__photo img { display: block; width: 100%; height: 100%; object-fit: cover; user-select: none; }
  .assortment__panels { display: grid; gap: 3rem; margin-top: 1.5rem; }
  .assortment__panel { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; min-width: 0; }
  .assortment__panel h3 { margin: 0 0 0.25rem; font: 400 1.875rem/1.1 'Vetrino', Georgia, serif; text-wrap: balance; }
  .assortment__panel p { margin: 0; font-size: 1rem; line-height: 1.45; }
  .assortment__ingredients { width: 100%; }
  .assortment__ingredients summary { display: flex; align-items: center; justify-content: space-between; min-height: 2.75rem; list-style: none; font: 400 1.5rem/1.2 'Vetrino', Georgia, serif; }
  .assortment__ingredients summary::-webkit-details-marker { display: none; }
  .assortment__ingredients summary span { font: 400 1.5rem/1 Arial, sans-serif; }
  .assortment__ingredients[open] summary span { transform: rotate(45deg); }
  .assortment__ingredients p { padding-top: 0.5rem; }
  .assortment__panel .assortment__highlight { width: fit-content; max-width: 100%; border: 1px solid currentColor; border-radius: 0.5rem; padding: 0.5rem 0.625rem; font-size: 0.875rem; line-height: 1.4; }
  .assortment__panel :global(.action-link) { min-height: 3.125rem; margin-top: auto; }
  .assortment__controls { display: none; }
  .assortment__carousel[data-enhanced] { display: grid; grid-template-columns: minmax(0, 1fr); row-gap: 1.5rem; }
  [data-enhanced] .assortment__title { grid-area: 1 / 1; margin: 0; justify-self: center; }
  [data-enhanced] .assortment__media { grid-area: 2 / 1; position: relative; width: min(100%, 38.125rem); aspect-ratio: 610 / 492; justify-self: center; min-width: 0; touch-action: pan-y pinch-zoom; isolation: isolate; user-select: none; }
  [data-enhanced] .assortment__photo { position: absolute; top: 50%; left: 50%; width: 65%; height: auto; margin: 0; transform-origin: center; will-change: transform, opacity; cursor: pointer; }
  [data-enhanced] .assortment__photo img { pointer-events: none; }
  [data-enhanced] .assortment__photo[data-slot='active'] { cursor: grab; }
  [data-enhanced] .assortment__media[data-dragging] .assortment__photo { cursor: grabbing; }
  [data-enhanced] .assortment__controls { display: flex; grid-area: 3 / 1; align-items: center; justify-content: center; gap: 1.25rem; }
  .assortment__controls button { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; padding: 0; border: 1px solid rgb(59 38 39 / 35%); border-radius: 50%; background: transparent; color: var(--text-primary); font-size: 1.25rem; cursor: pointer; }
  .assortment__controls span { font-size: 0.875rem; font-variant-numeric: tabular-nums; letter-spacing: 0.1em; }
  [data-enhanced] .assortment__panels { display: grid; grid-area: 4 / 1; margin: 0; min-width: 0; }
  [data-enhanced] .assortment__panel { grid-area: 1 / 1; visibility: hidden; pointer-events: none; }
  [data-enhanced] .assortment__panel[data-active] { visibility: visible; pointer-events: auto; }
  @media (hover: hover) {
    .assortment__ingredients summary:hover { color: var(--focus); }
  }
  @media (max-width: 39.999rem) {
    .assortment__panel :global(.action-link) { width: 100%; }
    .assortment__ingredients { border-block: 1px solid rgb(59 38 39 / 20%); padding-block: 0.25rem; }
    .assortment__ingredients[open] { padding-bottom: 1rem; }
  }
  @media (min-width: 64rem) {
    .assortment__carousel[data-enhanced] { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); column-gap: 8%; row-gap: 2.75rem; align-items: start; }
    [data-enhanced] .assortment__title { justify-self: start; align-self: start; white-space: nowrap; font-size: clamp(2rem, 3.35vw, 3rem); padding: 0.4rem 1.5rem 0.65rem; }
    [data-enhanced] .assortment__media { grid-area: 1 / 2 / 3 / 3; align-self: start; }
    [data-enhanced] .assortment__panels { grid-area: 2 / 1; margin-left: 8.5%; }
    [data-enhanced] .assortment__controls { display: none; }
    .assortment__panel { gap: 1.25rem; }
    .assortment__panel h3 { font-size: 1.875rem; }
    .assortment__ingredients summary { font-size: 1.875rem; }
    [data-enhanced] .assortment__ingredients summary { pointer-events: none; min-height: 0; }
    .assortment__ingredients p { padding-top: 0.25rem; }
    [data-enhanced] .assortment__ingredients summary span { display: none; }
    .assortment__panel p { line-height: 1.25; }
    .assortment__panel :global(.action-link) { padding: 0.75rem 1.75rem; font-size: 0.875rem; }
  }
</style>
