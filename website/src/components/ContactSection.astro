---
import { CONTACTS, HOME_SECTION_IDS } from '@/lib/site';
---

<section id={HOME_SECTION_IDS.contacts} class="contact-section">
  <div class="contact-section__content">
    <h2>Контакты</h2>
    <div class="contact-section__links">
      <a href={CONTACTS.bakery.href}>{CONTACTS.bakery.display}</a>
      <a href={CONTACTS.mobile.href}>{CONTACTS.mobile.display}</a>
    </div>
  </div>
</section>

<style>
  .contact-section {
    border-top: 1px solid color-mix(in srgb, var(--text-primary) 10%, transparent);
    padding-block: 3rem;
  }

  .contact-section__content {
    width: min(calc(100% - 2.5rem), 77.5rem);
    margin-inline: auto;
  }

  h2 {
    font-family: 'Vetrino', Georgia, serif;
    font-size: 1.875rem;
    font-weight: 400;
    line-height: 1;
  }

  .contact-section__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: 1.25rem;
    color: var(--text-muted);
  }

  a:hover {
    color: var(--text-primary);
    text-decoration-line: underline;
    text-underline-offset: 0.2em;
  }
</style>
