---
import { CONTACTS, getWhatsAppUrl } from '@/lib/site';

const whatsappUrl = getWhatsAppUrl();
---

<section id="contacts" class="contact-section" aria-labelledby="contacts-title">
  <h2 id="contacts-title" class="contact-section__title" data-motion="heading">Контакты</h2>
  <div class="contact-section__card" data-motion="image">
    <div class="contact-section__content">
      <div class="contact-section__item">
        <h3>Мы находимся по адресу</h3>
        <p class="contact-section__detail">
          <img
            class="contact-section__icon contact-section__icon--location"
            src="/footer/location.svg"
            width="16"
            height="21"
            alt=""
          />
          {
            CONTACTS.twoGisUrl ? (
              <a href={CONTACTS.twoGisUrl} target="_blank" rel="noopener noreferrer">
                {CONTACTS.address}
              </a>
            ) : (
              <span>{CONTACTS.address}</span>
            )
          }
        </p>
        <p class="contact-section__availability">Перед поездкой уточните наличие по телефону или в WhatsApp.</p>
      </div>

      <div class="contact-section__item">
        <h3>Время работы</h3>
        <p class="contact-section__detail">
          <img
            class="contact-section__icon contact-section__icon--time"
            src="/footer/time.svg"
            width="24"
            height="24"
            alt=""
          />
          <span>{CONTACTS.hours}</span>
        </p>
      </div>

      <div class="contact-section__item">
        <h3>Телефон</h3>
        <div class="contact-section__phones">
          <img
            class="contact-section__icon contact-section__icon--phone"
            src="/footer/phone.svg"
            width="22"
            height="22"
            alt=""
          />
          <span class="contact-section__phone-links">
            <a href={CONTACTS.bakery.href}>{CONTACTS.bakery.display}</a>
            <span class="contact-section__phone-separator" aria-hidden="true">;</span>
            <a href={CONTACTS.mobile.href}>{CONTACTS.mobile.display}</a>
          </span>
        </div>
      </div>

    </div>
    <div class="contact-section__socials">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Написать в WhatsApp"
      >
        <img src="/footer/whatsapp.svg" width="50" height="50" alt="" />
      </a>
      <a
        href={CONTACTS.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Открыть Instagram ZOTOV bakery"
      >
        <img src="/footer/instagram.svg" width="51" height="51" alt="" />
      </a>
    </div>
  </div>
</section>

<style>
  .contact-section {
    position: relative;
    padding-top: 35px;
  }

  .contact-section__title {
    position: absolute;
    top: -4px;
    right: -1.125rem;
    z-index: 1;
    display: inline-block;
    margin: 0;
    background: var(--text-primary);
    color: var(--surface-elevated);
    padding: 0.5rem 1rem;
    font-family: 'Vetrino', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1;
    transform: rotate(17deg);
    transform-origin: center;
    width: 11.125rem;
    text-align: center;
    white-space: nowrap;
  }

  .contact-section__card {
    --contact-card-background: url('/footer/contacts-background-390.svg');
    --contact-card-min-height: 226px;
    position: relative;
    isolation: isolate;
    box-sizing: border-box;
    min-height: var(--contact-card-min-height);
    margin-inline: -0.75rem;
    padding: 19px 1.5rem 11px 1.25rem;
    background: var(--contact-card-background) center / 100% 100% no-repeat;
  }

  .contact-section__content {
    position: relative;
    z-index: 1;
    display: grid;
    min-width: 0;
    gap: 5px;
  }

  .contact-section__item,
  .contact-section__detail {
    min-width: 0;
  }

  .contact-section__item h3 {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .contact-section__availability {
    margin: 0.35rem 0 0 1.5rem;
    color: var(--text-muted);
    font-size: 0.75rem;
    line-height: 1.25;
  }

  .contact-section__detail,
  .contact-section__phones {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    margin-top: 0.25rem;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .contact-section__detail img,
  .contact-section__phones > img {
    flex: none;
    margin-top: 0.05rem;
  }

  .contact-section__icon--location {
    width: 15px;
    height: 20px;
  }

  .contact-section__icon--time {
    width: 1.375rem;
    height: 1.375rem;
  }

  .contact-section__icon--phone {
    width: 1.125rem;
    height: 1.125rem;
  }

  .contact-section__detail a,
  .contact-section__detail span,
  .contact-section__phones a {
    min-width: 0;
    border-radius: 0.25rem;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 180ms ease;
  }

  .contact-section__detail a,
  .contact-section__detail span {
    overflow-wrap: anywhere;
  }

  .contact-section__detail a:is(:hover, :focus-visible),
  .contact-section__phones a:is(:hover, :focus-visible) {
    text-decoration-color: currentColor;
  }

  .contact-section__phones {
    display: flex;
    align-items: flex-start;
    gap: 6px;
  }

  .contact-section__phone-links {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    gap: 0.25rem 0.4rem;
  }

  .contact-section__phones a {
    min-height: 1.25rem;
    align-content: center;
    white-space: nowrap;
  }

  .contact-section__phone-separator {
    min-height: 1.25rem;
    line-height: 1.25;
  }

  .contact-section__socials {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    width: calc(100% + 2.75rem);
    margin-left: -1.25rem;
    margin-top: 10px;
  }

  .contact-section__socials a {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border-radius: 0.75rem;
    transition: transform 180ms var(--motion-ease);
  }

  .contact-section__socials a:active {
    transform: scale(0.96);
  }

  .contact-section__socials img {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (min-width: 40rem) {
    .contact-section {
      padding-top: 2.25rem;
    }

    .contact-section__card {
      --contact-card-background: url('/footer/contacts-background-768.svg');
      --contact-card-min-height: 310px;
      width: 100%;
      margin-inline: 0;
      padding: 2.5rem 2rem 1rem;
    }

    .contact-section__socials {
      width: calc(100% + 4rem);
      margin-left: -2rem;
    }

    .contact-section__title {
      top: 0.125rem;
      right: -1.3125rem;
      padding: 0.375rem 0.975rem;
      font-size: 1.875rem;
      width: 12.7rem;
    }

    .contact-section__content {
      gap: 19px;
    }

    .contact-section__item h3,
    .contact-section__detail,
    .contact-section__phones {
      font-size: 1.375rem;
      line-height: 1;
    }

    .contact-section__detail,
    .contact-section__phones {
      margin-top: 8px;
    }

    .contact-section__socials {
      margin-top: 12px;
    }

    .contact-section__card {
      padding-bottom: 20px;
    }

    .contact-section__phones {
      gap: 6px;
    }

    .contact-section__icon--location {
      width: 17px;
      height: 22px;
    }

    .contact-section__icon--time {
      width: 24px;
      height: 24px;
    }

    .contact-section__icon--phone {
      width: 22px;
      height: 22px;
    }

    .contact-section__phone-separator {
      min-height: 0;
      line-height: 22px;
    }
  }

  @media (min-width: 62rem) {
    .contact-section {
      padding-top: 3.9375rem;
    }

    .contact-section__card {
      --contact-card-background: url('/footer/contacts-background-1024.svg');
      --contact-card-min-height: 327px;
      padding: 2.875rem 2.796875rem 29px 3.125rem;
    }

    .contact-section__socials {
      width: calc(100% + 5.921875rem);
      margin-left: -3.125rem;
    }

    .contact-section__title {
      top: 0;
      right: -2.625rem;
      padding: 0.5rem 1.3rem;
      font-size: 2.5rem;
      width: 17rem;
    }

    .contact-section__content {
      gap: 19px;
    }

    .contact-section__detail,
    .contact-section__phones {
      gap: 6px;
    }

    .contact-section__detail a {
      white-space: nowrap;
    }

    .contact-section__socials a {
      width: 40px;
      height: 40px;
    }

    .contact-section__socials {
      margin-top: 13px;
    }

    .contact-section__phones,
    .contact-section__phone-links {
      flex-wrap: nowrap;
      white-space: nowrap;
    }
  }

  @media (min-width: 75rem) {
    .contact-section {
      padding-top: 64px;
    }

    .contact-section__card {
      --contact-card-background: url('/footer/contacts-background-1440.svg');
      --contact-card-min-height: 408px;
      padding: 54px 122px 41px 49px;
    }

    .contact-section__socials {
      width: calc(100% + 171px);
      margin-left: -49px;
      margin-top: 34px;
    }

    .contact-section__title {
      right: -90px;
      padding: 10px 26px;
      font-size: 48px;
      width: 328px;
    }

    .contact-section__item h3,
    .contact-section__detail,
    .contact-section__phones {
      font-size: 25px;
      line-height: 25px;
    }

    .contact-section__icon--location {
      width: 16px;
      height: 20px;
    }

    .contact-section__icon--time {
      width: 24px;
      height: 24px;
    }

    .contact-section__icon--phone {
      width: 22px;
      height: 22px;
    }

    .contact-section__content {
      max-width: 491px;
      gap: 24px;
    }

    .contact-section__detail,
    .contact-section__phones {
      margin-top: 10px;
      gap: 8px;
    }

    .contact-section__detail a {
      flex: 0 0 516px;
      width: 516px;
    }

    .contact-section__phone-links {
      flex: 0 0 468px;
      width: 468px;
      align-items: flex-start;
    }

    .contact-section__phone-separator {
      min-height: 0;
      line-height: 25px;
    }

    .contact-section__socials a {
      width: 50px;
      height: 50px;
    }

    .contact-section__socials {
      margin-top: 34px;
    }
  }

  @media (min-width: 75rem) and (max-width: 87.499rem) {
    .contact-section__title {
      right: 0;
    }
  }
</style>
