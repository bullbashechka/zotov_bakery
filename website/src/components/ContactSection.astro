---
import { CONTACTS, getWhatsAppUrl } from '@/lib/site';

const whatsappUrl = getWhatsAppUrl('general');
---

<section id="contacts" class="contact-section" aria-labelledby="contacts-title">
  <h2 id="contacts-title" class="contact-section__title" data-footer-reveal-item>Контакты</h2>
  <div class="contact-section__card">
    <img class="contact-section__frame" src="/footer/frame-1050.svg" alt="" aria-hidden="true" />
    <span class="contact-section__scallop contact-section__scallop--top" aria-hidden="true"></span>
    <span class="contact-section__scallop contact-section__scallop--right" aria-hidden="true"></span>
    <span class="contact-section__scallop contact-section__scallop--bottom" aria-hidden="true"></span>
    <span class="contact-section__scallop contact-section__scallop--left" aria-hidden="true"></span>
    <div class="contact-section__content" data-footer-reveal-item>
      <div class="contact-section__item">
        <h3>Мы находимся по адресу</h3>
        <p class="contact-section__detail">
          <img src="/footer/location.svg" width="16" height="21" alt="" />
          {CONTACTS.twoGisUrl ? (
            <a href={CONTACTS.twoGisUrl} target="_blank" rel="noopener noreferrer">{CONTACTS.address}</a>
          ) : (
            <span>{CONTACTS.address}</span>
          )}
        </p>
      </div>

      <div class="contact-section__item">
        <h3>Время работы</h3>
        <p class="contact-section__detail">
          <img src="/footer/time.svg" width="24" height="24" alt="" />
          <span>{CONTACTS.hours}</span>
        </p>
      </div>

      <div class="contact-section__item">
        <h3>Телефон</h3>
        <div class="contact-section__phones">
          <img src="/footer/phone.svg" width="22" height="22" alt="" />
          <a href={CONTACTS.bakery.href}>{CONTACTS.bakery.display}</a>
          <a href={CONTACTS.mobile.href}>{CONTACTS.mobile.display}</a>
        </div>
      </div>

      <div class="contact-section__socials">
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="Написать в WhatsApp">
          <img src="/footer/whatsapp.svg" width="50" height="50" alt="" />
        </a>
        <a href={CONTACTS.instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Открыть Instagram ZOTOV bakery">
          <img src="/footer/instagram.svg" width="51" height="51" alt="" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    position: relative;
  }

  .contact-section__title {
    position: relative;
    z-index: 1;
    display: inline-block;
    margin-bottom: 1.25rem;
    background: var(--text-primary);
    color: var(--surface-elevated);
    padding: 0.5rem 1rem;
    font-family: 'Vetrino', Georgia, serif;
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: 400;
    line-height: 1;
  }

  .contact-section__card {
    position: relative;
    margin: 0.9rem;
    background: var(--surface);
    border-radius: 1.5rem;
  }

  .contact-section__frame {
    position: absolute;
    z-index: 0;
    inset: 0;
    display: none;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .contact-section__content {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.5rem;
    padding: 2.5rem 1.5rem;
  }

  .contact-section__item h3 {
    font-size: clamp(1.25rem, 3.5vw, 1.5625rem);
    font-weight: 600;
    line-height: 1;
  }

  .contact-section__detail,
  .contact-section__phones {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    margin-top: 0.6rem;
    font-size: clamp(1.125rem, 3.4vw, 1.5625rem);
    font-weight: 500;
    line-height: 1.15;
  }

  .contact-section__detail img,
  .contact-section__phones > img {
    width: 1.3rem;
    height: 1.3rem;
    flex: none;
    margin-top: 0.05rem;
  }

  .contact-section__detail a,
  .contact-section__phones a {
    border-radius: 0.25rem;
    color: inherit;
    text-decoration: none;
  }

  .contact-section__detail a:hover,
  .contact-section__phones a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .contact-section__phones {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.35rem 0.55rem;
  }

  .contact-section__phones > img {
    grid-row: span 2;
  }

  .contact-section__phones a {
    min-height: 2.75rem;
    align-content: center;
  }

  .contact-section__socials {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .contact-section__socials a {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border-radius: 0.75rem;
  }

  .contact-section__socials img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .contact-section__scallop {
    position: absolute;
    z-index: 0;
    display: block;
    background: radial-gradient(circle, var(--surface) 66%, transparent 69%);
    pointer-events: none;
  }

  .contact-section__scallop--top,
  .contact-section__scallop--bottom {
    right: 0;
    left: 0;
    height: 1.8rem;
    background-size: 3.6rem 1.8rem;
    background-repeat: repeat-x;
  }

  .contact-section__scallop--top {
    top: -0.9rem;
    background-position: center bottom;
  }

  .contact-section__scallop--bottom {
    bottom: -0.9rem;
    background-position: center top;
  }

  .contact-section__scallop--left,
  .contact-section__scallop--right {
    top: 0;
    bottom: 0;
    width: 1.8rem;
    background-size: 1.8rem 3.6rem;
    background-repeat: repeat-y;
  }

  .contact-section__scallop--left {
    left: -0.9rem;
    background-position: right center;
  }

  .contact-section__scallop--right {
    right: -0.9rem;
    background-position: left center;
  }

  @media (min-width: 40rem) {
    .contact-section__card {
      width: min(100%, 41.375rem);
      aspect-ratio: 662 / 407;
      margin: 0 auto;
      background: transparent;
      border-radius: 0;
    }

    .contact-section__frame {
      display: block;
    }

    .contact-section__scallop {
      display: none;
    }

    .contact-section__title {
      margin-bottom: 0.5rem;
    }

    .contact-section__content {
      position: absolute;
      inset: 0;
      gap: 1.5rem;
      padding: 3.25rem;
    }

    .contact-section__phones {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem 0.55rem;
    }

    .contact-section__phones > img {
      margin-top: 0.65rem;
    }

    .contact-section__phones a + a::before {
      margin-right: 0.55rem;
      content: ';';
    }
  }

  @media (min-width: 75rem) {
    .contact-section__title {
      position: absolute;
      top: -3.55rem;
      right: -2.5rem;
      margin: 0;
      padding-inline: 1.625rem;
      font-size: 3rem;
      transform: rotate(17deg);
      transform-origin: center;
    }

    .contact-section__content {
      padding: 3.25rem 3.1rem 2.5rem;
    }
  }
</style>
