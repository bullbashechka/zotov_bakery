---
import { CONTACTS, HOME_NAV_LINKS } from '@/lib/site';
import HeaderMascot from '@/components/HeaderMascot.astro';

const desktopLeftLinks = HOME_NAV_LINKS.slice(0, 3);
const desktopRightLinks = HOME_NAV_LINKS.slice(3);
---

<site-header id="site-top" data-menu-open="false">
  <div class="site-header__content">
    <a class="site-header__logo" href="#main-content" aria-label="ZOTOV bakery, в начало страницы">
      <HeaderMascot />
    </a>

    <nav class="site-header__desktop-nav" aria-label="Основная навигация">
      <div class="site-header__link-group site-header__link-group--left">
        {desktopLeftLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
      <div aria-hidden="true"></div>
      <div class="site-header__desktop-actions">
        <div class="site-header__link-group">
          {desktopRightLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
        <a class="site-header__phone" href={CONTACTS.mobile.href}>
          <span class="site-header__phone-icon" aria-hidden="true">
            <img src="/phone-icon.svg" width="20" height="20" alt="" />
          </span>
          <span>{CONTACTS.mobile.display}</span>
        </a>
      </div>
    </nav>

    <div class="site-header__mobile-actions">
      <a class="site-header__call" href={CONTACTS.mobile.href}>
        <span class="site-header__phone-icon" aria-hidden="true">
          <img src="/phone-icon.svg" width="20" height="20" alt="" />
        </span>
        <span>{CONTACTS.mobile.display}</span>
      </a>
      <button
        class="site-header__menu-toggle"
        type="button"
        aria-controls="mobile-navigation"
        aria-expanded="false"
      >
        <span class="sr-only">Открыть меню</span>
        <span class="site-header__menu-icon" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <button class="site-header__backdrop" type="button" tabindex="-1" aria-hidden="true"></button>

  <div id="mobile-navigation" class="site-header__mobile-panel">
    <div class="site-header__mobile-panel-content">
      <nav aria-label="Основная навигация">
        {HOME_NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
      <a class="site-header__mobile-phone" href={CONTACTS.mobile.href}>
        <span class="site-header__phone-icon" aria-hidden="true">
          <img src="/phone-icon.svg" width="20" height="20" alt="" />
        </span>
        <span>{CONTACTS.mobile.display}</span>
      </a>
    </div>
  </div>
</site-header>

<script is:inline>
  class SiteHeader extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready === 'true') return;

      this.dataset.ready = 'true';
      this.toggle = this.querySelector('.site-header__menu-toggle');
      this.panel = this.querySelector('.site-header__mobile-panel');
      this.backdrop = this.querySelector('.site-header__backdrop');
      this.menuLinks = [...this.panel.querySelectorAll('a[href^="#"]')];
      this.desktopQuery = window.matchMedia('(min-width: 80rem)');
      this.events = new AbortController();
      this.compact = false;
      this.lockedScrollY = 0;

      this.panel.inert = true;
      this.panel.setAttribute('aria-hidden', 'true');

      this.handleToggle = () => this.setMenuOpen(this.dataset.menuOpen !== 'true');
      this.handleKeydown = (event) => {
        if (event.key === 'Escape' && this.dataset.menuOpen === 'true') {
          event.preventDefault();
          this.setMenuOpen(false, { restoreFocus: true });
          return;
        }

        if (event.key !== 'Tab' || this.dataset.menuOpen !== 'true') return;

        const focusable = [this.toggle, ...this.panel.querySelectorAll('a[href], button:not([disabled])')]
          .filter((element) => element && element.getClientRects().length > 0);
        const first = focusable[0];
        const last = focusable.at(-1);

        if (!first || !last) return;
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      };
      this.handleScroll = () => {
        if (this.dataset.menuOpen === 'true') return;

        const scrollY = window.scrollY;
        const nextCompact = this.compact ? scrollY > 8 : scrollY >= 32;

        if (nextCompact !== this.compact) {
          this.compact = nextCompact;
          this.toggleAttribute('data-compact', nextCompact);
          this.syncMascot();
        }
      };
      this.handleBreakpoint = () => {
        if (this.desktopQuery.matches) this.setMenuOpen(false);
        this.handleScroll();
      };

      this.toggle.addEventListener('click', this.handleToggle, { signal: this.events.signal });
      this.backdrop.addEventListener(
        'click',
        () => this.setMenuOpen(false, { restoreFocus: true }),
        { signal: this.events.signal },
      );
      window.addEventListener('keydown', this.handleKeydown, { signal: this.events.signal });
      window.addEventListener('scroll', this.handleScroll, {
        passive: true,
        signal: this.events.signal,
      });
      this.desktopQuery.addEventListener('change', this.handleBreakpoint, { signal: this.events.signal });

      this.menuLinks.forEach((link) => {
        link.addEventListener(
          'click',
          () => {
            const targetId = link.getAttribute('href');
            const target = targetId ? document.querySelector(targetId) : null;

            this.setMenuOpen(false);

            if (target) {
              window.setTimeout(() => {
                const heading = target.querySelector('h1, h2, h3, h4, h5, h6');
                if (!heading) return;

                heading.setAttribute('tabindex', '-1');
                heading.focus({ preventScroll: true });
                window.setTimeout(() => heading.removeAttribute('tabindex'), 1000);
              }, 0);
            }
          },
          { signal: this.events.signal },
        );
      });

      this.handleScroll();
    }

    disconnectedCallback() {
      this.events?.abort();
      this.unlockPageScroll();
    }

    syncMascot() {
      const mascot = this.querySelector('header-mascot');
      if (mascot)
        mascot.dataset.state =
          this.compact || this.dataset.menuOpen === 'true' ? 'compact' : 'expanded';
    }

    setMenuOpen(open, options = {}) {
      const { restoreFocus = false } = options;
      const isOpen = open && !this.desktopQuery.matches;

      this.dataset.menuOpen = String(isOpen);
      this.syncMascot();
      this.toggle.setAttribute('aria-expanded', String(isOpen));
      this.toggle.querySelector('.sr-only').textContent = isOpen ? 'Закрыть меню' : 'Открыть меню';
      this.panel.inert = !isOpen;
      this.panel.setAttribute('aria-hidden', String(!isOpen));

      if (isOpen) {
        this.lockPageScroll();
        window.setTimeout(() => this.menuLinks[0]?.focus({ preventScroll: true }), 0);
      } else {
        this.unlockPageScroll();
      }
      if (!isOpen && restoreFocus) this.toggle.focus({ preventScroll: true });
    }

    lockPageScroll() {
      if (document.documentElement.dataset.headerMenuOpen === 'true') return;

      this.lockedScrollY = window.scrollY;
      document.documentElement.dataset.headerMenuOpen = 'true';
      document.body.style.position = 'fixed';
      document.body.style.top = `-${this.lockedScrollY}px`;
      document.body.style.width = '100%';
      document.body.style.overflow = 'hidden';
    }

    unlockPageScroll() {
      if (document.documentElement.dataset.headerMenuOpen !== 'true') return;

      delete document.documentElement.dataset.headerMenuOpen;
      document.body.style.removeProperty('position');
      document.body.style.removeProperty('top');
      document.body.style.removeProperty('width');
      document.body.style.removeProperty('overflow');
      window.scrollTo(0, this.lockedScrollY);
    }
  }

  if (!customElements.get('site-header')) customElements.define('site-header', SiteHeader);
</script>

<style>
  site-header {
    position: fixed;
    z-index: 40;
    top: 0;
    right: 0;
    left: 0;
    display: block;
    height: var(--header-expanded-height);
    border-bottom: 1px solid transparent;
    background: transparent;
    box-shadow: none;
    color: var(--text-primary);
    pointer-events: auto;
    transition:
      height 220ms var(--motion-ease),
      background-color 220ms var(--motion-ease),
      border-color 220ms var(--motion-ease),
      box-shadow 220ms var(--motion-ease);
  }

  site-header[data-compact],
  site-header[data-menu-open='true'] {
    height: var(--header-compact-height);
    border-bottom-color: color-mix(in srgb, var(--text-primary) 12%, transparent);
    background: var(--surface-elevated);
    box-shadow: 0 0.25rem 1rem var(--header-shadow);
  }

  site-header:not(:defined) {
    position: relative;
    height: auto;
    min-height: var(--header-expanded-height);
    background: var(--surface-elevated);
  }

  .site-header__content {
    position: relative;
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: space-between;
    margin-inline: auto;
    padding-right: 0.875rem;
    padding-left: 0.625rem;
  }

  .site-header__logo {
    display: block;
    flex: none;
  }

  .site-header__desktop-nav,
  .site-header__desktop-actions {
    display: none;
  }

  .site-header__mobile-actions {
    display: flex;
    align-items: center;
  }

  .site-header__call {
    display: none;
  }

  .site-header__desktop-nav a,
  .site-header__mobile-panel a {
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 0.0625rem;
    text-underline-offset: 0.3em;
    transition: text-decoration-color 180ms ease;
  }

  .site-header__desktop-nav a:is(:hover, :focus-visible),
  .site-header__mobile-panel a:is(:hover, :focus-visible) {
    text-decoration-color: currentColor;
  }

  .site-header__menu-toggle {
    display: inline-flex;
    width: 2.75rem;
    min-width: 2.75rem;
    height: 2.75rem;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: inherit;
  }

  .site-header__menu-icon,
  .site-header__menu-icon::before,
  .site-header__menu-icon::after {
    display: block;
    width: 1.4025rem;
    height: 0.125rem;
    border-radius: 999px;
    background: currentColor;
    transition:
      transform 220ms var(--motion-ease),
      opacity 220ms var(--motion-ease);
  }

  .site-header__menu-icon {
    position: relative;
  }

  .site-header__menu-icon::before,
  .site-header__menu-icon::after {
    position: absolute;
    left: 0;
    content: '';
  }

  .site-header__menu-icon::before {
    transform: translateY(-0.375rem);
  }

  .site-header__menu-icon::after {
    transform: translateY(0.375rem);
  }

  site-header[data-menu-open='true'] .site-header__menu-icon {
    background: transparent;
  }

  site-header[data-menu-open='true'] .site-header__menu-icon::before {
    transform: rotate(45deg);
  }

  site-header[data-menu-open='true'] .site-header__menu-icon::after {
    transform: rotate(-45deg);
  }

  .site-header__mobile-panel,
  .site-header__backdrop {
    display: none;
  }

  site-header:not(:defined) .site-header__menu-toggle {
    display: none;
  }

  site-header:not(:defined) .site-header__mobile-panel {
    display: block;
    padding-block: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--text-primary) 12%, transparent);
  }

  site-header:not(:defined) .site-header__mobile-panel nav {
    display: grid;
  }

  site-header:not(:defined) .site-header__mobile-panel a {
    display: flex;
    min-height: 3rem;
    align-items: center;
  }

  site-header:not(:defined) .site-header__mobile-phone {
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-weight: 600;
  }

  site-header:defined .site-header__backdrop {
    position: fixed;
    z-index: 0;
    top: var(--header-compact-height);
    right: 0;
    bottom: 0;
    left: 0;
    display: block;
    border: 0;
    background: rgb(36 23 25 / 14%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms var(--motion-ease);
  }

  site-header:defined .site-header__mobile-panel {
    position: fixed;
    z-index: 1;
    top: var(--header-compact-height);
    right: 0;
    left: 0;
    display: block !important;
    max-height: calc(100dvh - var(--header-compact-height));
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-block: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--text-primary) 12%, transparent);
    background: var(--surface-elevated);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-0.5rem);
    transition:
      opacity 220ms var(--motion-ease),
      transform 220ms var(--motion-ease),
      visibility 220ms step-end;
  }

  site-header:defined[data-menu-open='true'] .site-header__backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  site-header:defined[data-menu-open='true'] .site-header__mobile-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    transition:
      opacity 220ms var(--motion-ease),
      transform 220ms var(--motion-ease);
  }

  .site-header__mobile-panel-content {
    display: grid;
    width: min(calc(100% - 2rem), 34rem);
    gap: 0.75rem;
    margin-inline: auto;
  }

  .site-header__mobile-panel nav {
    display: grid;
  }

  .site-header__mobile-panel nav a,
  .site-header__mobile-phone {
    display: flex;
    min-height: 3rem;
    align-items: center;
    border-bottom: 1px solid color-mix(in srgb, var(--text-primary) 10%, transparent);
    font-size: 1rem;
    font-weight: 600;
  }

  .site-header__mobile-phone {
    gap: 0.625rem;
    border-bottom: 0;
    color: var(--text-muted);
  }

  .site-header__phone-icon,
  .site-header__phone-icon img {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
  }

  @media (min-width: 48rem) and (max-width: 79.999rem) {
    .site-header__content {
      padding: 0;
    }

    .site-header__logo {
      position: absolute;
      z-index: 1;
      top: 0.75rem;
      left: 50%;
      transform: translateX(-50%);
    }

    .site-header__desktop-nav {
      position: absolute;
      inset: 0;
      display: block;
    }

    .site-header__link-group,
    .site-header__desktop-actions,
    .site-header__phone {
      display: flex;
      align-items: center;
    }

    .site-header__link-group {
      gap: 1.875rem;
    }

    .site-header__desktop-nav a {
      font-size: 1rem;
      line-height: 1;
    }

    .site-header__phone {
      width: 13.3125rem;
      gap: 0.5rem;
      font-size: 1.25rem;
      font-weight: 500;
      white-space: nowrap;
    }

    .site-header__mobile-actions {
      position: absolute;
      top: 50%;
      right: clamp(1.5rem, 4vw, 2.5rem);
      display: none;
      align-items: center;
      gap: 0.5rem;
      transform: translateY(-50%);
    }

    .site-header__call {
      align-items: center;
      gap: 0.5rem;
      font-size: 1.125rem;
      font-weight: 500;
      line-height: 1;
      white-space: nowrap;
    }

    site-header:is([data-compact], [data-menu-open='true']) .site-header__logo {
      top: 50%;
      left: clamp(1.5rem, 4vw, 2.5rem);
      transform: translateY(-50%);
    }

    site-header:is([data-compact], [data-menu-open='true']) .site-header__desktop-nav {
      display: none;
    }

    site-header:is([data-compact], [data-menu-open='true']) .site-header__mobile-actions,
    site-header:is([data-compact], [data-menu-open='true']) .site-header__call {
      display: flex;
    }
  }

  @media (min-width: 48rem) and (max-width: 55.999rem) {
    .site-header__link-group--left {
      position: absolute;
      bottom: 1.25rem;
      left: calc(50% - 17rem);
    }

    .site-header__desktop-actions {
      display: contents;
    }

    .site-header__desktop-actions .site-header__link-group {
      position: absolute;
      bottom: 1.25rem;
      left: calc(50% + 5.75rem);
    }

    .site-header__phone {
      position: absolute;
      top: 3rem;
      right: clamp(2.5rem, 5vw, 4.375rem);
    }
  }

  @media (min-width: 56rem) and (max-width: 79.999rem) {
    .site-header__desktop-nav {
      top: auto;
      right: clamp(2.5rem, 6.84vw, 4.375rem);
      bottom: 1.25rem;
      left: clamp(2.5rem, 6.84vw, 4.375rem);
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 1.25rem;
    }

    .site-header__desktop-actions {
      gap: 1.75rem;
    }
  }

  @media (min-width: 80rem) {
    site-header {
      height: var(--header-expanded-height);
    }

    site-header[data-compact] {
      height: var(--header-compact-height);
    }

    .site-header__content {
      width: min(calc(100% - 2.5rem), max(1240px, 86.1111vw));
      padding: 0;
    }

    .site-header__logo {
      position: absolute;
      z-index: 1;
      top: clamp(26px, 1.8056vw, 34.667px);
      left: 50%;
      transform: translateX(-50%);
    }

    .site-header__desktop-nav {
      position: absolute;
      top: clamp(38px, 2.6389vw, 50.667px);
      right: 0;
      left: 0;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: start;
    }

    .site-header__link-group,
    .site-header__desktop-actions,
    .site-header__phone {
      display: flex;
      align-items: center;
    }

    .site-header__link-group {
      gap: clamp(30px, 2.0833vw, 40px);
    }

    .site-header__link-group--left {
      justify-self: start;
      margin-left: 0.375rem;
    }

    .site-header__desktop-actions {
      justify-self: end;
      gap: clamp(28px, 1.9444vw, 37.333px);
      align-items: start;
    }

    .site-header__desktop-nav a {
      font-size: clamp(16px, 1.1111vw, 21.333px);
      line-height: 1;
    }

    .site-header__phone {
      width: clamp(213px, 14.7917vw, 284px);
      gap: clamp(8px, 0.5556vw, 10.667px);
      font-size: clamp(20px, 1.3889vw, 26.667px);
      font-weight: 500;
      white-space: nowrap;
    }

    .site-header__phone img {
      flex: none;
    }

    site-header[data-compact] .site-header__logo {
      top: 50%;
      transform: translate(-50%, -50%);
    }

    site-header[data-compact] .site-header__desktop-nav {
      top: 50%;
      transform: translateY(-50%);
    }

    .site-header__mobile-actions,
    .site-header__mobile-panel,
    .site-header__backdrop {
      display: none !important;
    }
  }
</style>
