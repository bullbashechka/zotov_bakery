---
import { CONTACTS, HOME_NAV_LINKS } from '@/lib/site';

const desktopLeftLinks = HOME_NAV_LINKS.slice(0, 3);
const desktopRightLinks = HOME_NAV_LINKS.slice(3);
---

<site-header id="site-top" data-menu-open="false">
  <div class="site-header__content">
    <a class="site-header__logo" href="#main-content" aria-label="ZOTOV bakery, в начало страницы">
      <img src="/zotov-logo.svg" width="331" height="127" alt="ZOTOV bakery" />
    </a>

    <nav class="site-header__desktop-nav" aria-label="Основная навигация">
      <div class="site-header__link-group site-header__link-group--left">
        {desktopLeftLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
      <div aria-hidden="true"></div>
      <div class="site-header__desktop-actions">
        <div class="site-header__link-group">
          {desktopRightLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
        <a class="site-header__phone" href={CONTACTS.mobile.href}>
          <span class="site-header__phone-icon" aria-hidden="true">
            <img src="/phone-icon.svg" width="20" height="20" alt="" />
          </span>
          <span>{CONTACTS.mobile.display}</span>
        </a>
      </div>
    </nav>

    <div class="site-header__mobile-actions">
      <a class="site-header__call" href={CONTACTS.mobile.href}>Позвонить</a>
      <button
        class="site-header__menu-toggle"
        type="button"
        aria-controls="mobile-navigation"
        aria-expanded="false"
      >
        <span class="sr-only">Открыть меню</span>
        <span class="site-header__menu-icon" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <button class="site-header__backdrop" type="button" tabindex="-1" aria-hidden="true"></button>

  <div id="mobile-navigation" class="site-header__mobile-panel">
    <div class="site-header__mobile-panel-content">
      <nav aria-label="Основная навигация">
        {HOME_NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
      <a class="site-header__mobile-phone" href={CONTACTS.mobile.href}>
        <span class="site-header__phone-icon" aria-hidden="true">
          <img src="/phone-icon.svg" width="20" height="20" alt="" />
        </span>
        <span>{CONTACTS.mobile.display}</span>
      </a>
    </div>
  </div>
</site-header>

<script is:inline>
  class SiteHeader extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready === 'true') return;

      this.dataset.ready = 'true';
      this.toggle = this.querySelector('.site-header__menu-toggle');
      this.panel = this.querySelector('.site-header__mobile-panel');
      this.backdrop = this.querySelector('.site-header__backdrop');
      this.menuLinks = [...this.panel.querySelectorAll('a[href^="#"]')];
      this.desktopQuery = window.matchMedia('(min-width: 75rem)');
      this.menuScrollStart = 0;
      this.compact = false;

      this.handleToggle = () => this.setMenuOpen(this.dataset.menuOpen !== 'true');
      this.handleEscape = (event) => {
        if (event.key === 'Escape' && this.dataset.menuOpen === 'true') {
          event.preventDefault();
          this.setMenuOpen(false, { restoreFocus: true });
        }
      };
      this.handleFocusOut = () => {
        requestAnimationFrame(() => {
          if (this.dataset.menuOpen === 'true' && !this.contains(document.activeElement)) {
            this.setMenuOpen(false);
          }
        });
      };
      this.handleScroll = () => {
        const scrollY = window.scrollY;
        const nextCompact = this.compact ? scrollY > 8 : scrollY >= 32;

        if (nextCompact !== this.compact) {
          this.compact = nextCompact;
          this.toggleAttribute('data-compact', nextCompact);
        }

        if (
          !this.desktopQuery.matches
          && this.dataset.menuOpen === 'true'
          && Math.abs(scrollY - this.menuScrollStart) >= 8
        ) {
          this.setMenuOpen(false, { restoreFocus: this.panel.contains(document.activeElement) });
        }
      };
      this.handleBreakpoint = () => {
        if (this.desktopQuery.matches) this.setMenuOpen(false);
        this.handleScroll();
      };

      this.toggle.addEventListener('click', this.handleToggle);
      this.backdrop.addEventListener('click', () => this.setMenuOpen(false, { restoreFocus: true }));
      this.addEventListener('focusout', this.handleFocusOut);
      window.addEventListener('keydown', this.handleEscape);
      window.addEventListener('scroll', this.handleScroll, { passive: true });
      this.desktopQuery.addEventListener('change', this.handleBreakpoint);

      this.menuLinks.forEach((link) => {
        link.addEventListener('click', () => {
          const targetId = link.getAttribute('href');
          const target = targetId ? document.querySelector(targetId) : null;

          this.setMenuOpen(false);

          if (target) {
            window.setTimeout(() => {
              const heading = target.querySelector('h1, h2, h3, h4, h5, h6');
              if (heading) {
                heading.setAttribute('tabindex', '-1');
                heading.focus({ preventScroll: true });
              }
            }, 0);
          }
        });
      });

      this.handleScroll();
    }

    disconnectedCallback() {
      if (!this.toggle) return;

      this.toggle.removeEventListener('click', this.handleToggle);
      this.removeEventListener('focusout', this.handleFocusOut);
      window.removeEventListener('keydown', this.handleEscape);
      window.removeEventListener('scroll', this.handleScroll);
      this.desktopQuery.removeEventListener('change', this.handleBreakpoint);
    }

    setMenuOpen(open, options = {}) {
      const { restoreFocus = false } = options;
      const isOpen = open && !this.desktopQuery.matches;

      this.dataset.menuOpen = String(isOpen);
      this.toggle.setAttribute('aria-expanded', String(isOpen));
      this.toggle.querySelector('.sr-only').textContent = isOpen ? 'Закрыть меню' : 'Открыть меню';

      if (isOpen) this.menuScrollStart = window.scrollY;
      if (!isOpen && restoreFocus) this.toggle.focus({ preventScroll: true });
    }
  }

  if (!customElements.get('site-header')) customElements.define('site-header', SiteHeader);
</script>

<style>
  site-header {
    position: fixed;
    z-index: 40;
    top: 0;
    right: 0;
    left: 0;
    display: block;
    height: var(--header-expanded-height);
    border-bottom: 1px solid transparent;
    background: transparent;
    box-shadow: none;
    color: var(--text-primary);
    pointer-events: auto;
    transition: height 220ms var(--motion-ease), background-color 220ms var(--motion-ease), border-color 220ms var(--motion-ease),
      box-shadow 220ms var(--motion-ease);
  }

  site-header[data-compact],
  site-header[data-menu-open='true'] {
    height: var(--header-compact-height);
    border-bottom-color: color-mix(in srgb, var(--text-primary) 12%, transparent);
    background: var(--surface-elevated);
    box-shadow: 0 0.25rem 1rem var(--header-shadow);
  }

  site-header:not(:defined) {
    position: relative;
    height: auto;
    min-height: var(--header-expanded-height);
    background: var(--surface-elevated);
  }

  .site-header__content,
  .site-header__mobile-panel-content {
    width: min(calc(100% - 2rem), 77.5rem);
    margin-inline: auto;
  }

  .site-header__content {
    position: relative;
    display: flex;
    height: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .site-header__logo {
    display: block;
    flex: none;
  }

  .site-header__logo picture,
  .site-header__logo img {
    display: block;
  }

  .site-header__logo img {
    width: 10rem;
    height: auto;
    transition: width 220ms var(--motion-ease);
  }

  site-header[data-compact] .site-header__logo img,
  site-header[data-menu-open='true'] .site-header__logo img {
    width: 7.5rem;
  }

  .site-header__desktop-nav,
  .site-header__desktop-actions {
    display: none;
  }

  .site-header__mobile-actions {
    display: flex;
    align-items: center;
  }

  .site-header__call {
    display: none;
  }

  .site-header__desktop-nav a,
  .site-header__mobile-panel a {
    text-decoration-line: underline;
    text-decoration-color: transparent;
    transition: text-decoration-color 180ms ease;
    text-decoration-thickness: 0.0625rem;
    text-underline-offset: 0.3em;
  }

  .site-header__desktop-nav a:is(:hover, :focus-visible),
  .site-header__mobile-panel a:is(:hover, :focus-visible) {
    text-decoration-color: currentColor;
  }

  .site-header__menu-toggle {
    display: inline-flex;
    width: 2.0625rem;
    min-width: 2.0625rem;
    height: 1.5625rem;
    min-height: 1.5625rem;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: inherit;
  }

  .site-header__menu-icon,
  .site-header__menu-icon::before,
  .site-header__menu-icon::after {
    display: block;
    width: 1.25rem;
    height: 0.125rem;
    border-radius: 999px;
    background: currentColor;
    transition: transform 220ms var(--motion-ease), opacity 220ms var(--motion-ease);
  }

  .site-header__menu-icon {
    position: relative;
  }

  .site-header__menu-icon::before,
  .site-header__menu-icon::after {
    position: absolute;
    left: 0;
    content: '';
  }

  .site-header__menu-icon::before {
    transform: translateY(-0.375rem);
  }

  .site-header__menu-icon::after {
    transform: translateY(0.375rem);
  }

  site-header[data-menu-open='true'] .site-header__menu-icon {
    background: transparent;
  }

  site-header[data-menu-open='true'] .site-header__menu-icon::before {
    transform: rotate(45deg);
  }

  site-header[data-menu-open='true'] .site-header__menu-icon::after {
    transform: rotate(-45deg);
  }

  .site-header__mobile-panel,
  .site-header__backdrop {
    display: none;
  }

  site-header:not(:defined) .site-header__menu-toggle {
    display: none;
  }

  site-header:not(:defined) .site-header__mobile-panel {
    display: block;
    padding-block: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--text-primary) 12%, transparent);
  }

  site-header:not(:defined) .site-header__mobile-panel nav {
    display: grid;
  }

  site-header:not(:defined) .site-header__mobile-panel a {
    display: flex;
    min-height: 3rem;
    align-items: center;
  }

  site-header:not(:defined) .site-header__mobile-phone {
    margin-top: 0.5rem;
    gap: 0.5rem;
    font-weight: 600;
  }

  site-header:defined .site-header__backdrop {
    position: fixed;
    z-index: 0;
    top: var(--header-compact-height);
    right: 0;
    bottom: 0;
    left: 0;
    display: block;
    border: 0;
    background: rgb(36 23 25 / 14%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms var(--motion-ease);
  }

  site-header:defined .site-header__mobile-panel {
    position: fixed;
    z-index: 1;
    top: var(--header-compact-height);
    right: 0;
    left: 0;
    display: block !important;
    max-height: calc(100dvh - var(--header-compact-height));
    overflow-y: auto;
    border-top: 1px solid color-mix(in srgb, var(--text-primary) 12%, transparent);
    background: var(--surface-elevated);
    padding-block: 1rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-0.5rem);
    transition: opacity 220ms var(--motion-ease), transform 220ms var(--motion-ease), visibility 220ms step-end;
  }

  site-header:defined[data-menu-open='true'] .site-header__backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  site-header:defined[data-menu-open='true'] .site-header__mobile-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    transition: opacity 220ms var(--motion-ease), transform 220ms var(--motion-ease);
  }

  .site-header__mobile-panel-content {
    display: grid;
    gap: 0.75rem;
  }

  .site-header__mobile-panel nav {
    display: grid;
  }

  .site-header__mobile-panel nav a,
  .site-header__mobile-phone {
    display: flex;
    min-height: 3rem;
    align-items: center;
    border-bottom: 1px solid color-mix(in srgb, var(--text-primary) 10%, transparent);
    font-size: 1rem;
    font-weight: 600;
  }

  .site-header__mobile-phone {
    gap: 0.625rem;
    border-bottom: 0;
    color: var(--text-muted);
  }

  .site-header__phone-icon,
  .site-header__phone-icon img {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
  }

  @media (min-width: 75rem) {
    site-header {
      height: var(--header-expanded-height);
    }

    site-header[data-compact] {
      height: var(--header-compact-height);
    }

    .site-header__content {
      display: grid;
      width: min(calc(100% - 2.5rem), 77.5rem);
      grid-template-columns: 1fr auto 1fr;
    }

    .site-header__logo {
      position: absolute;
      z-index: 1;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }

    .site-header__logo img {
      width: 20.6875rem;
      height: 7.9375rem;
      transition: width 220ms var(--motion-ease), height 220ms var(--motion-ease);
    }

    site-header[data-compact] .site-header__logo img {
      width: 14.75rem;
      height: 5.65625rem;
    }

    .site-header__desktop-nav {
      display: grid;
      grid-column: 1 / -1;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }

    .site-header__link-group,
    .site-header__desktop-actions,
    .site-header__phone {
      display: flex;
      align-items: center;
    }

    .site-header__link-group {
      gap: 1.875rem;
    }

    .site-header__link-group--left {
      justify-self: start;
    }

    .site-header__desktop-actions {
      justify-self: end;
      gap: 1.75rem;
    }

    .site-header__desktop-nav a {
      font-size: 1rem;
      line-height: 1;
    }

    .site-header__phone {
      gap: 0.5rem;
      font-size: 1.25rem;
      font-weight: 500;
      white-space: nowrap;
    }

    .site-header__phone img {
      flex: none;
    }

    .site-header__mobile-actions,
    .site-header__mobile-panel,
    .site-header__backdrop {
      display: none !important;
    }
  }
</style>
