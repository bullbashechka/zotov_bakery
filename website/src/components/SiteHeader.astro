---
import { CONTACTS, HOME_NAV_LINKS } from '@/lib/site';

const desktopLeftLinks = HOME_NAV_LINKS.slice(0, 3);
const desktopRightLinks = HOME_NAV_LINKS.slice(3);
---

<site-header id="site-top" class="site-header-control" data-menu-open="false">
  <div class="site-header__content site-container">
    <a class="site-header__logo" href="#site-top" aria-label="ZOTOV bakery, в начало страницы">
      <picture>
        <source media="(prefers-color-scheme: dark)" srcset="/zotov-logo-dark.svg" />
        <img src="/zotov-logo.svg" width="331" height="127" alt="ZOTOV bakery" />
      </picture>
    </a>

    <nav class="site-header__desktop-nav" aria-label="Основная навигация">
      <div class="site-header__link-group site-header__link-group--left">
        {desktopLeftLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
      <div aria-hidden="true"></div>
      <div class="site-header__desktop-actions">
        <div class="site-header__link-group">
          {desktopRightLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
        <a class="site-header__phone" href={CONTACTS.mobile.href}>
          <picture class="site-header__phone-icon" aria-hidden="true">
            <source media="(prefers-color-scheme: dark)" srcset="/phone-icon-dark.svg" />
            <img src="/phone-icon.svg" width="20" height="20" alt="" />
          </picture>
          <span>{CONTACTS.mobile.display}</span>
        </a>
      </div>
    </nav>

    <div class="site-header__mobile-actions">
      <a class="site-header__call" href={CONTACTS.mobile.href}>Позвонить</a>
      <button
        class="site-header__menu-toggle"
        type="button"
        aria-controls="mobile-navigation"
        aria-expanded="false"
      >
        <span class="sr-only">Открыть меню</span>
        <span class="site-header__menu-icon" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <button class="site-header__backdrop" type="button" tabindex="-1" aria-hidden="true"></button>

  <div id="mobile-navigation" class="site-header__mobile-panel">
    <div class="site-container site-header__mobile-panel-content">
      <nav aria-label="Основная навигация">
        {HOME_NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
      <a class="site-header__mobile-phone" href={CONTACTS.mobile.href}>
        <picture class="site-header__phone-icon" aria-hidden="true">
          <source media="(prefers-color-scheme: dark)" srcset="/phone-icon-dark.svg" />
          <img src="/phone-icon.svg" width="20" height="20" alt="" />
        </picture>
        <span>{CONTACTS.mobile.display}</span>
      </a>
    </div>
  </div>
</site-header>

<script is:inline>
  class SiteHeader extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready === 'true') return;

      this.dataset.ready = 'true';
      this.toggle = this.querySelector('.site-header__menu-toggle');
      this.panel = this.querySelector('.site-header__mobile-panel');
      this.backdrop = this.querySelector('.site-header__backdrop');
      this.menuLinks = [...this.panel.querySelectorAll('a[href^="#"]')];
      this.desktopQuery = window.matchMedia('(min-width: 75rem)');
      this.menuScrollStart = 0;
      this.compact = false;

      this.handleToggle = () => this.setMenuOpen(this.dataset.menuOpen !== 'true');
      this.handleEscape = (event) => {
        if (event.key === 'Escape' && this.dataset.menuOpen === 'true') {
          event.preventDefault();
          this.setMenuOpen(false, { restoreFocus: true });
        }
      };
      this.handleFocusOut = () => {
        requestAnimationFrame(() => {
          if (this.dataset.menuOpen === 'true' && !this.contains(document.activeElement)) {
            this.setMenuOpen(false);
          }
        });
      };
      this.handleScroll = () => {
        const scrollY = window.scrollY;
        const nextCompact = this.compact ? scrollY > 8 : scrollY >= 32;

        if (nextCompact !== this.compact) {
          this.compact = nextCompact;
          this.toggleAttribute('data-compact', nextCompact);
        }

        if (
          !this.desktopQuery.matches
          && this.dataset.menuOpen === 'true'
          && Math.abs(scrollY - this.menuScrollStart) >= 8
        ) {
          this.setMenuOpen(false, { restoreFocus: this.panel.contains(document.activeElement) });
        }
      };
      this.handleBreakpoint = () => {
        if (this.desktopQuery.matches) this.setMenuOpen(false);
        this.handleScroll();
      };

      this.toggle.addEventListener('click', this.handleToggle);
      this.backdrop.addEventListener('click', () => this.setMenuOpen(false, { restoreFocus: true }));
      this.addEventListener('focusout', this.handleFocusOut);
      window.addEventListener('keydown', this.handleEscape);
      window.addEventListener('scroll', this.handleScroll, { passive: true });
      this.desktopQuery.addEventListener('change', this.handleBreakpoint);

      this.menuLinks.forEach((link) => {
        link.addEventListener('click', () => {
          const targetId = link.getAttribute('href');
          const target = targetId ? document.querySelector(targetId) : null;

          this.setMenuOpen(false);

          if (target) {
            window.setTimeout(() => {
              const heading = target.querySelector('h1, h2, h3, h4, h5, h6');
              if (heading) {
                heading.setAttribute('tabindex', '-1');
                heading.focus({ preventScroll: true });
              }
            }, 0);
          }
        });
      });

      this.handleScroll();
    }

    disconnectedCallback() {
      if (!this.toggle) return;

      this.toggle.removeEventListener('click', this.handleToggle);
      this.removeEventListener('focusout', this.handleFocusOut);
      window.removeEventListener('keydown', this.handleEscape);
      window.removeEventListener('scroll', this.handleScroll);
      this.desktopQuery.removeEventListener('change', this.handleBreakpoint);
    }

    setMenuOpen(open, options = {}) {
      const { restoreFocus = false } = options;
      const isOpen = open && !this.desktopQuery.matches;

      this.dataset.menuOpen = String(isOpen);
      this.toggle.setAttribute('aria-expanded', String(isOpen));
      this.toggle.querySelector('.sr-only').textContent = isOpen ? 'Закрыть меню' : 'Открыть меню';

      if (isOpen) this.menuScrollStart = window.scrollY;
      if (!isOpen && restoreFocus) this.toggle.focus({ preventScroll: true });
    }
  }

  if (!customElements.get('site-header')) customElements.define('site-header', SiteHeader);
</script>
