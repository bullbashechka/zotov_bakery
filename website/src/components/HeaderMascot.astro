---
import logo from '../../public/zotov-logo.svg?raw';

// The original artwork keeps the neck, head and eyes in consecutive paths.
const artwork = logo
  .replace('<svg ', '<svg aria-hidden="true" ')
  .replace('<path d="M84.2789', '<g data-mascot-head><path d="M84.2789')
  .replace('<path d="M96.8225', '</g><path d="M96.8225');
---

<header-mascot class="header-mascot" set:html={artwork} />

<script>
  import { gsap } from 'gsap';

  class HeaderMascot extends HTMLElement {
    private media?: ReturnType<typeof gsap.matchMedia>;

    connectedCallback() {
      if (this.media) return;
      const head = this.querySelector<SVGGElement>('[data-mascot-head]');
      if (!head) return;
      this.media = gsap.matchMedia();
      this.media.add('(min-width: 75rem) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)', () => {
        const events = new AbortController();
        gsap.set(head, { svgOrigin: '76 49' });
        const turn = gsap.quickTo(head, 'rotation', { duration: 0.45, ease: 'power3.out' });
        const reset = () => turn(0);
        document.addEventListener('pointermove', (event) => {
          if (event.pointerType === 'touch') return;
          const bounds = this.getBoundingClientRect();
          const x = bounds.left + bounds.width * 80 / 331;
          const y = bounds.top + bounds.height * 35 / 127;
          // A restrained turn around the neck; never flip the brand artwork.
          const horizontal = (event.clientX - x) / (innerWidth / 2);
          const vertical = (event.clientY - y) / (innerHeight / 2);
          turn(gsap.utils.clamp(-10, 10, horizontal * 6 + vertical * 4));
        }, { signal: events.signal });
        document.documentElement.addEventListener('pointerleave', reset, { signal: events.signal });
        window.addEventListener('blur', reset, { signal: events.signal });
        return () => events.abort();
      });
    }

    disconnectedCallback() {
      this.media?.revert();
      this.media = undefined;
    }
  }

  if (!customElements.get('header-mascot')) customElements.define('header-mascot', HeaderMascot);
</script>

<style>
  .header-mascot {
    display: block;
    width: 10rem;
    transition: width 220ms var(--motion-ease);
  }

  .header-mascot :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  :global(site-header[data-compact]) .header-mascot,
  :global(site-header[data-menu-open='true']) .header-mascot {
    width: 7.5rem;
  }

  @media (min-width: 75rem) {
    .header-mascot { width: 20.6875rem; }
    :global(site-header[data-compact]) .header-mascot { width: 14.75rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-mascot { transition: none; }
  }
</style>
