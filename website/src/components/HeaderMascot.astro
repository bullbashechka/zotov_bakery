---
interface Props {
  state?: 'expanded' | 'compact';
}
const { state = 'expanded' } = Astro.props;

import logo from '../../public/zotov-logo.svg?raw';

// The original artwork keeps the neck, head and eyes in consecutive paths.
const artwork = logo
  .replace('<svg ', '<svg aria-hidden="true" ')
  .replace('<path d="M84.2789', '<g data-mascot-head><path d="M84.2789')
  .replace('<path d="M96.8225', '</g><path d="M96.8225');
---

<header-mascot class="header-mascot" data-state={state} set:html={artwork} />

<script>
  import { gsap } from 'gsap';

  class HeaderMascot extends HTMLElement {
    private media?: ReturnType<typeof gsap.matchMedia>;

    connectedCallback() {
      if (this.media) return;
      const head = this.querySelector<SVGGElement>('[data-mascot-head]');
      if (!head) return;
      this.media = gsap.matchMedia();
      this.media.add(
          '(min-width: 80rem) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)',
        () => {
          const events = new AbortController();
          gsap.set(head, { svgOrigin: '76 49' });
          const turn = gsap.quickTo(head, 'rotation', { duration: 0.45, ease: 'power3.out' });
          let nod: gsap.core.Timeline | undefined;
          this.addEventListener(
            'pointerenter',
            () => {
              if (nod?.isActive()) return;
              turn.tween.pause();
              nod = gsap
                .timeline()
                .to(head, { rotation: 4, duration: 0.2, ease: 'power2.out' })
                .to(head, { rotation: 0, duration: 0.25, ease: 'power2.inOut' });
            },
            { signal: events.signal },
          );
          const reset = () => turn(0);
          document.addEventListener(
            'pointermove',
            (event) => {
              if (event.pointerType === 'touch' || document.hidden || nod?.isActive()) return;
              const bounds = this.getBoundingClientRect();
              const x = bounds.left + (bounds.width * 80) / 331;
              const y = bounds.top + (bounds.height * 35) / 127;
              // A restrained turn around the neck; never flip the brand artwork.
              const horizontal = (event.clientX - x) / (innerWidth / 2);
              const vertical = (event.clientY - y) / (innerHeight / 2);
              turn(gsap.utils.clamp(-10, 10, horizontal * 6 + vertical * 4));
            },
            { signal: events.signal },
          );
          document.documentElement.addEventListener('pointerleave', reset, {
            signal: events.signal,
          });
          window.addEventListener('blur', reset, { signal: events.signal });
          return () => {
            events.abort();
            nod?.kill();
          };
        },
      );
    }

    disconnectedCallback() {
      this.media?.revert();
      this.media = undefined;
    }
  }

  if (!customElements.get('header-mascot')) customElements.define('header-mascot', HeaderMascot);
</script>

<style>
  .header-mascot {
    display: block;
    width: 10rem;
    transition: width 220ms var(--motion-ease);
  }

  .header-mascot :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .header-mascot[data-state='compact'] {
    width: 10rem;
  }

  @media (min-width: 48rem) and (max-width: 79.999rem) {
    .header-mascot {
      width: 14.375rem;
    }

    .header-mascot[data-state='compact'] {
      width: 9rem;
    }
  }

  @media (min-width: 80rem) {
    .header-mascot {
      width: clamp(331px, 22.9861vw, 441.333px);
    }
    .header-mascot[data-state='compact'] {
      width: clamp(180px, 12.5vw, 240px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-mascot {
      transition: none;
    }
  }
</style>
