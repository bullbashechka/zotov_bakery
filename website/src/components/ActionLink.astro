---
interface Props {
  href: string;
  variant: 'primary' | 'secondary' | 'surface';
  size?: 'regular' | 'compact' | 'selection';
  fullWidth?: boolean | 'mobile';
  external?: boolean;
}

const { href, variant, fullWidth = false, size = 'regular', external = false } = Astro.props;
---

<a
  class="action-link"
  data-variant={variant}
  data-size={size}
  data-full-width={fullWidth}
  {href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <slot />
</a>

<script>
  import { gsap } from 'gsap';
  import { mountMotion } from '@/lib/motion-lifecycle';
  const cleanup = mountMotion(
    '.action-link',
    ({ element: button, fine, signal, context, onCleanup }) => {
      const tween = (target: gsap.TweenTarget, vars: gsap.TweenVars) =>
        context.add(() => gsap.to(target, { duration: 0.22, overwrite: 'auto', ...vars }));
      button.dataset.interactiveMotion = 'true';
      let down = false;
      const restore = () => {
        down = false;
        tween(button, { scale: 1, ease: 'back.out(1.6)' });
      };
      button.addEventListener(
        'pointerdown',
        () => {
          down = true;
          tween(button, { scale: 0.97, duration: 0.12 });
        },
        { signal },
      );
      window.addEventListener(
        'pointerup',
        () => {
          if (down) restore();
        },
        { signal },
      );
      button.addEventListener('pointercancel', restore, { signal });
      button.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'Enter') tween(button, { scale: 0.97 });
        },
        { signal },
      );
      button.addEventListener('keyup', restore, { signal });
      button.addEventListener('blur', restore, { signal });
      if (fine) {
        button.addEventListener('pointerenter', () => tween(button, { y: -2 }), { signal });
        button.addEventListener('pointerleave', () => tween(button, { y: 0 }), { signal });
      }
      onCleanup(() => button.removeAttribute('data-interactive-motion'));
      button.addEventListener(
        'action-emphasis',
        () => tween(button, { scale: 1.02, delay: 1.2, duration: 0.2, yoyo: true, repeat: 1 }),
        { signal },
      );
    },
  );
  if (import.meta.hot) import.meta.hot.dispose(cleanup);
</script>

<style>
  .action-link {
    display: inline-flex;
    width: fit-content;
    max-width: 100%;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    padding: 0.625rem 1.875rem;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.25;
    transition:
      background-color var(--motion-interaction-duration) ease,
      border-color var(--motion-interaction-duration) ease,
      color var(--motion-interaction-duration) ease;
  }

  .action-link[data-variant='primary'] {
    min-width: 8.625rem;
    background: var(--text-primary);
    color: var(--surface-elevated);
  }

  .action-link[data-full-width='true'] {
    width: 100%;
  }

  @media (hover: hover) and (pointer: fine) {
    .action-link[data-variant='primary']:hover {
      background: var(--accent-muted);
    }
  }

  .action-link[data-variant='secondary'] {
    min-width: 15.5rem;
    border-color: currentColor;
    color: var(--text-primary);
  }

  .action-link[data-size='selection'] {
    min-width: 0;
    min-height: 3.125rem;
    font-size: 1rem;
    line-height: 1.25;
    white-space: nowrap;
  }

  .action-link[data-size='selection'][data-variant='secondary'] {
    background: var(--page);
  }

  @media (hover: hover) and (pointer: fine) {
    .action-link[data-variant='secondary']:hover {
      background: var(--surface-elevated);
    }
  }

  .action-link[data-variant='surface'] {
    min-height: 3rem;
    border-radius: 0.375rem;
    background: var(--surface);
    color: var(--text-primary);
    font-size: 1rem;
    font-weight: 600;
  }

  @media (hover: hover) and (pointer: fine) {
    .action-link[data-variant='surface']:hover {
      background: var(--surface-elevated);
    }
  }

  .action-link:not([data-interactive-motion]):active {
    transform: scale(0.98);
  }

  @media (min-width: 40rem) {
    .action-link {
      min-height: 3.125rem;
      padding-inline: 2.5rem;
      font-size: 1rem;
    }

    .action-link[data-variant='primary'] {
      min-width: 10.625rem;
    }

    .action-link[data-variant='secondary'] {
      min-width: 20.1875rem;
    }

    .action-link[data-size='selection'] {
      min-width: 0;
      min-height: 50px;
      box-sizing: border-box;
      font-size: 16px;
      line-height: 16px;
    }

    .action-link[data-size='selection'][data-variant='primary'] {
      width: 261px;
      justify-self: center;
    }

    .action-link[data-size='selection'][data-variant='secondary'] {
      width: 292px;
      justify-self: center;
    }

  }
  .action-link[data-size='compact'] {
    min-height: 3.125rem;
    font-size: 1rem;
  }
  @media (max-width: 39.999rem) {
    .action-link[data-full-width='mobile'] {
      width: 100%;
    }
  }
  @media (min-width: 64rem) {
    .action-link[data-size='compact'] {
      padding: 0.75rem 1.75rem;
      font-size: 1rem;
    }
  }
</style>
