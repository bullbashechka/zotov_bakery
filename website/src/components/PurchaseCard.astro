---
import { Picture } from 'astro:assets';
import ActionLink from './ActionLink.astro';
import type { PurchaseOption } from '@/lib/purchase';
interface Props { option: PurchaseOption }
const { option } = Astro.props;
const hasAddresses = Boolean(option.addresses?.length);
const addressesId = `purchase-addresses-${option.kind}`;
---

<article class="where-to-buy__card" data-kind={option.kind} data-motion="card" data-flippable={hasAddresses || undefined}>
  <div class="purchase-card__rotor">
    <div class="purchase-card__front">
      <div class="where-to-buy__image-wrap" aria-hidden="true">
        {typeof option.image === 'string' ? (
          <img class="where-to-buy__image" data-kind={option.kind} src={option.image} width="400" height="280" alt={option.imageAlt} loading="lazy" />
        ) : (
          <Picture
            src={option.image}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[400, 640, 960, 1280, 1528]}
            sizes="(min-width: 1280px) 544px, (min-width: 1200px) calc((100vw - 60px) * 544 / 1220), (min-width: 768px) calc((100vw - 60px) / 2), (min-width: 736px) 704px, calc(100vw - 32px)"
            width={640}
            quality={80}
            alt={option.imageAlt}
            loading="lazy"
          />
        )}
      </div>
      <div class="where-to-buy__content">
        <h3>{option.title}</h3>
        <p>{option.description}</p>
        <div class="purchase-card__action">
          {hasAddresses ? (
            <button type="button" class="purchase-card__button purchase-card__open" aria-expanded="false" aria-controls={addressesId}>{option.action}</button>
          ) : (
            <ActionLink variant="surface" href={option.href} fullWidth external>{option.action}</ActionLink>
          )}
        </div>
      </div>
    </div>
    {hasAddresses && (
      <div id={addressesId} class="purchase-card__back" role="group" aria-labelledby={`${addressesId}-title`}>
        <div class="purchase-card__back-header">
          <div><h3 id={`${addressesId}-title`}>{option.addressesTitle ?? option.title}</h3><p>Петропавловск</p></div>
          <button type="button" class="purchase-card__back-button" aria-label={`Назад к карточке: ${option.title}`}>Назад</button>
        </div>
        <ul class="purchase-card__addresses">
          {option.addresses?.map((address) => (
            <li><a href={address.href} target="_blank" rel="noopener noreferrer"><span>{address.label}<small>Открыть в 2ГИС</small></span><span aria-hidden="true">↗</span></a></li>
          ))}
        </ul>
        <p class="purchase-card__note">Ассортимент и наличие уточняйте в выбранном магазине.</p>
      </div>
    )}
  </div>
</article>

<script>
  import { gsap } from 'gsap';
  import { mountMotion } from '@/lib/motion-lifecycle';
  // Functional controls also run when reduced motion disables mountMotion.
  const disposers: (() => void)[] = [];
  document.querySelectorAll<HTMLElement>('.where-to-buy__card[data-flippable]').forEach((card) => {
    if (card.dataset.enhanced) return;
    const front = card.querySelector<HTMLElement>('.purchase-card__front');
    const back = card.querySelector<HTMLElement>('.purchase-card__back');
    const openButton = card.querySelector<HTMLButtonElement>('.purchase-card__open');
    const backButton = card.querySelector<HTMLButtonElement>('.purchase-card__back-button');
    if (!front || !back || !openButton || !backButton) return;
    const events = new AbortController();
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    const options = { signal: events.signal };
    let pinned = false;
    let hovering = false;
    const setOpen = (opened: boolean, moveFocus = false) => {
      const active = document.activeElement;
      if ((opened ? front : back).contains(active) && active instanceof HTMLElement) active.blur();
      card.dataset.open = String(opened);
      openButton.setAttribute('aria-expanded', String(opened));
      front.inert = opened;
      back.inert = !opened;
      front.setAttribute('aria-hidden', String(opened));
      back.setAttribute('aria-hidden', String(!opened));
      if (moveFocus) {
        // Delay until visibility switches so focus works during a reverse flip too.
        requestAnimationFrame(() => {
          if (events.signal.aborted || card.dataset.open !== String(opened)) return;
          (opened ? backButton : openButton).focus({ preventScroll: true });
        });
      }
    };
    const close = () => { pinned = false; setOpen(false, true); };
    card.dataset.enhanced = 'true';
    setOpen(false);
    card.addEventListener('pointerenter', () => { hovering = true; }, options);
    openButton.addEventListener('pointerenter', () => { if (fine.matches) setOpen(true); }, options);
    card.addEventListener('pointerdown', (event) => {
      // On desktop hover can turn the button away before the click lands.
      if (event.button === 0 && card.dataset.open === 'true' && event.target instanceof Element && !event.target.closest('a, .purchase-card__back-button')) {
        pinned = true;
        setOpen(true, true);
      }
    }, options);
    openButton.addEventListener('click', () => { pinned = true; setOpen(true, true); }, options);
    backButton.addEventListener('click', close, options);
    card.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && card.dataset.open === 'true') { event.preventDefault(); close(); }
    }, options);
    card.addEventListener('pointerleave', () => {
      hovering = false;
      if (!pinned && !card.contains(document.activeElement)) setOpen(false);
    }, options);
    card.addEventListener('focusout', () => {
      queueMicrotask(() => {
        if (!events.signal.aborted && !pinned && !hovering && !card.contains(document.activeElement)) setOpen(false);
      });
    }, options);
    disposers.push(() => {
      events.abort();
      front.inert = false; back.inert = false;
      front.removeAttribute('aria-hidden'); back.removeAttribute('aria-hidden');
      openButton.setAttribute('aria-expanded', 'false');
      delete card.dataset.enhanced; delete card.dataset.open;
    });
  });
  const cleanup = mountMotion('.where-to-buy__card', ({ element: card, fine, signal, context }) => {
    const image = card.querySelector('img');
    const tween = (active: boolean) => context.add(() => {
      gsap.to(card, { translate: active ? '0px -4px' : '0px 0px', duration: 0.22, overwrite: 'auto' });
      if (image) gsap.to(image, { scale: active ? 1.025 : 1, duration: 0.22, overwrite: 'auto' });
    });
    if (fine) {
      card.addEventListener('pointerenter', () => tween(true), { signal });
      card.addEventListener('pointerleave', () => tween(false), { signal });
    }
  });
  if (import.meta.hot) import.meta.hot.dispose(() => { cleanup(); disposers.forEach((dispose) => dispose()); });
</script>

<style>
  .where-to-buy__card { min-width: 0; perspective: 1200px; }
  .purchase-card__rotor { height: 100%; display: grid; transform-style: preserve-3d; transition: transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1); }
  .purchase-card__front, .purchase-card__back { min-width: 0; overflow: hidden; border-radius: 12px; background: var(--text-primary); color: var(--page); backface-visibility: hidden; }
  .purchase-card__front { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto 1fr; }
  .where-to-buy__image-wrap { position: relative; min-width: 0; min-height: 0; aspect-ratio: 10 / 7; overflow: hidden; border-radius: 12px; background: var(--surface); }
  .where-to-buy__card[data-kind='supermarket'] .where-to-buy__image-wrap { background: #fdfdfd; }
  .where-to-buy__card[data-kind='semeiniy'] .where-to-buy__image-wrap { background: #2d9703; }
  .where-to-buy__image-wrap :global(img) { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: contain; }
  .where-to-buy__card[data-kind='bakery'] .where-to-buy__image-wrap :global(img) { padding: 8.625%; }
  .where-to-buy__card[data-kind='semeiniy'] .where-to-buy__image-wrap :global(img) { padding: 9%; }
  .where-to-buy__content { display: flex; flex-direction: column; min-width: 0; gap: 10px; padding: 20px; }
  .where-to-buy__content h3, .purchase-card__back h3 { font-family: 'Vetrino', Georgia, serif; font-size: 24px; font-weight: 400; line-height: 1; }
  .where-to-buy__content h3, .where-to-buy__content p, .purchase-card__back h3, .purchase-card__back p, .purchase-card__addresses a { overflow-wrap: anywhere; }
  .where-to-buy__content p { font-size: 16px; line-height: 1.2; }
  .purchase-card__back p { font-size: 14px; line-height: 1.3; }
  .purchase-card__action { margin-top: auto; padding-top: 12px; }
  .purchase-card__button, .purchase-card__back-button { min-height: 48px; border: 1px solid transparent; border-radius: 6px; padding: 10px; font: inherit; font-size: 16px; line-height: 1.2; cursor: pointer; }
  .purchase-card__button { width: 100%; background: var(--surface); color: var(--text-primary); font-weight: 600; transition: background-color 0.2s ease; }
  .purchase-card__button:hover { background: var(--surface-elevated); }
  .purchase-card__open, .purchase-card__back-button { display: none; }
  [data-enhanced] .purchase-card__open, [data-enhanced] .purchase-card__back-button { display: inline-flex; align-items: center; justify-content: center; }
  .purchase-card__back { display: flex; flex-direction: column; gap: 12px; padding: 16px; }
  /* Both faces remain in the same grid cell, so opening never changes height. */
  [data-enhanced] .purchase-card__front, [data-enhanced] .purchase-card__back { grid-area: 1 / 1; }
  [data-enhanced] .purchase-card__back { transform: rotateY(180deg); }
  [data-open='true'] .purchase-card__rotor { transform: rotateY(180deg); }
  .purchase-card__back-header { display: flex; flex-wrap: wrap; align-items: start; justify-content: space-between; gap: 8px; }
  .purchase-card__back-header p { margin-top: 6px; }
  .purchase-card__back-button { flex-shrink: 0; border-color: var(--page); color: var(--page); background: transparent; font-size: 14px; }
  .purchase-card__addresses { display: grid; list-style: none; margin: 0; padding: 0; }
  .purchase-card__addresses a { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 48px; padding: 8px 0; border-bottom: 1px solid rgb(244 236 230 / 25%); color: inherit; font-size: 14px; line-height: 1.3; text-decoration: none; transition: color 0.2s ease; }
  .purchase-card__addresses a:hover { color: var(--surface-elevated); text-decoration: underline; text-underline-offset: 0.2rem; }
  .purchase-card__addresses small { display: block; margin-top: 4px; font-size: 12px; opacity: 0.8; }
  .purchase-card__note { margin-top: auto; opacity: 0.8; }
  @media (min-width: 1200px) {
    .where-to-buy__card[data-kind='bakery'] { grid-column: 1; grid-row: 1 / 3; }
    .where-to-buy__card[data-kind='delivery'] { grid-column: 2 / 4; grid-row: 1; }
    .where-to-buy__card[data-kind='supermarket'] { grid-column: 2; grid-row: 2; }
    .where-to-buy__card[data-kind='semeiniy'] { grid-column: 3; grid-row: 2; }
    .where-to-buy__card:not([data-kind='bakery']) .purchase-card__front {
      grid-template-columns: minmax(0, 191fr) minmax(0, 252fr);
      grid-template-rows: 1fr;
      min-height: 229px;
    }
    .where-to-buy__card[data-kind='delivery'] .purchase-card__front { grid-template-columns: minmax(0, 544fr) minmax(0, 352fr); }
    .where-to-buy__card:not([data-kind='bakery']) .where-to-buy__image-wrap { aspect-ratio: auto; }
    .where-to-buy__card[data-kind='delivery'] .where-to-buy__image-wrap :global(img) { object-fit: cover; }
    .where-to-buy__content { padding: 17px 14px 8px 16px; }
    .where-to-buy__card[data-kind='delivery'] .where-to-buy__content { padding: 22px 7px 9px 22px; }
    .where-to-buy__card[data-kind='delivery'] .where-to-buy__content h3 { max-width: 255px; }
    .where-to-buy__card[data-kind='bakery'] .where-to-buy__content { padding: 24px 20px 6px; }
    .where-to-buy__card[data-kind='bakery'] .purchase-card__action { margin-inline: -14px; }
    .purchase-card__back h3 { font-size: 22px; }
    .purchase-card__addresses { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 16px; }
  }
  @media (prefers-reduced-motion: reduce) { .purchase-card__rotor { transition: none; } }
</style>
