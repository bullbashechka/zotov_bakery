---
import { Picture } from 'astro:assets';
import honeyCake from '@/assets/honey-cake.png';
import ActionLink from '@/components/ActionLink.astro';
import { getWhatsAppUrl, HOME_SECTION_IDS } from '@/lib/site';

type Hotspot = {
  id: string;
  title: string;
  body: string;
  x: number;
  y: number;
  width: number;
  placement: 'top' | 'bottom-right' | 'bottom-left';
};

const hotspots: Hotspot[] = [
  {
    id: 'protein-cream',
    title: 'Белковый крем',
    body: 'Воздушный и нежный. Добавляет медовику лёгкости и мягко дополняет сладость коржей.',
    x: 76,
    y: 46,
    width: 326,
    placement: 'top',
  },
  {
    id: 'honey-layers',
    title: 'Медовые коржи',
    body: 'Мягкие, хорошо пропитанные, с медовым ароматом. Именно они дают десерту тот самый домашний вкус.',
    x: 75,
    y: 64,
    width: 395,
    placement: 'bottom-right',
  },
  {
    id: 'cream',
    title: 'Крем',
    body: 'Соединяет коржи и делает их ещё мягче. Благодаря ей медовик получается нежным и хорошо пропитанным.',
    x: 61,
    y: 62,
    width: 384,
    placement: 'bottom-left',
  },
];

const whatsappUrl = getWhatsAppUrl('general');
---

<section id={HOME_SECTION_IDS.honeyCake} class="honey-cake" aria-labelledby="honey-cake-title">
  <div class="honey-cake__surface" aria-hidden="true"></div>
  <div class="honey-cake__container">
    <h2 id="honey-cake-title" class="honey-cake__title" data-motion="heading">
      Медовик от <span class="honey-cake__brand-z">Z</span>OTOV bakery
    </h2>

    <div class="honey-cake__content">
      <honey-cake-hotspots class="honey-cake__media" data-motion="image">
        <Picture
          src={honeyCake}
          formats={['avif', 'webp']}
          widths={[320, 480, 640, 768, 934]}
          sizes="(max-width: 47.999rem) min(100vw - 2.5rem, 35rem), (max-width: 63.999rem) min(78vw, 38rem), min(54vw, 43rem)"
          alt="Медовик ZOTOV bakery с белковым кремом и цветочным оформлением"
          loading="lazy"
        />

        {hotspots.map((hotspot) => {
          const summaryId = `honey-cake-${hotspot.id}-summary`;
          const panelId = `honey-cake-${hotspot.id}-panel`;

          return (
            <details
              class="honey-cake__hotspot"
              data-placement={hotspot.placement}
              style={`--hotspot-x: ${hotspot.x}%; --hotspot-y: ${hotspot.y}%; --hotspot-width: ${hotspot.width}px;`}
            >
              <summary id={summaryId} aria-controls={panelId}>
                <span class="sr-only">Подробнее: {hotspot.title}</span>
                <span class="honey-cake__hotspot-mark" aria-hidden="true">+</span>
              </summary>
              <div id={panelId} class="honey-cake__hotspot-panel" role="region" aria-labelledby={summaryId}>
                <div class="honey-cake__hotspot-content">
                  <h3>{hotspot.title}</h3>
                  <p>{hotspot.body}</p>
                </div>
              </div>
            </details>
          );
        })}
      </honey-cake-hotspots>

      <p class="honey-cake__hint">Нажмите на «+», чтобы узнать подробнее.</p>

      <div class="honey-cake__copy">
        <h3 data-motion="heading">Описание</h3>
        <p data-motion="copy">
          Мягкие, хорошо пропитанные медовые коржи напоминают тот самый домашний медовик из
          детства. Белковый воздушный крем сверху торта буквально тает во рту, а умеренная
          сладость делает десерт более нежным и легким.
        </p>
        <p data-motion="copy">
          Этот медовик Светлана Зотова пекла для семьи и близких. Со временем домашний рецепт
          стал ассоциироваться с брендом.
        </p>
        <ActionLink variant="primary" href={whatsappUrl} fullWidth target="_blank" rel="noopener noreferrer">
          Узнать цену и наличие
        </ActionLink>
      </div>
    </div>
  </div>

  <div class="honey-cake__scallop honey-cake__scallop--top" aria-hidden="true"></div>
  <div class="honey-cake__scallop honey-cake__scallop--bottom" aria-hidden="true"></div>
</section>

<script>
  class HoneyCakeHotspots extends HTMLElement {
    private items: HTMLDetailsElement[] = [];
    private abortController: AbortController | null = null;

    connectedCallback() {
      if (this.abortController) return;

      this.abortController = new AbortController();
      const { signal } = this.abortController;
      this.items = Array.from(this.querySelectorAll<HTMLDetailsElement>('.honey-cake__hotspot'));

      this.items.forEach((item) => {
        item.addEventListener('toggle', this.handleToggle, { signal });
      });
      document.addEventListener('pointerdown', this.handlePointerDown, { signal });
      document.addEventListener('keydown', this.handleKeydown, { signal });
      window.addEventListener('resize', this.handleResize, { signal });
    }

    disconnectedCallback() {
      this.abortController?.abort();
      this.abortController = null;
      this.items = [];
    }

    private handleToggle = (event: Event) => {
      const current = event.currentTarget as HTMLDetailsElement;
      current.dataset.expanded = String(current.open);
      if (!current.open) return;

      this.items.forEach((item) => {
        if (item !== current) item.open = false;
      });
      requestAnimationFrame(() => this.positionMobilePanel(current));
    };

    private handlePointerDown = (event: PointerEvent) => {
      if (this.contains(event.target as Node)) return;
      this.closeAll();
    };

    private handleKeydown = (event: KeyboardEvent) => {
      if (event.key !== 'Escape') return;

      const active = this.items.find((item) => item.open);
      if (!active) return;

      event.preventDefault();
      active.open = false;
      active.querySelector<HTMLElement>('summary')?.focus();
    };

    private closeAll() {
      this.items.forEach((item) => {
        item.open = false;
      });
    }

    private handleResize = () => {
      const active = this.items.find((item) => item.open);
      if (active) this.positionMobilePanel(active);
    };

    private positionMobilePanel(item: HTMLDetailsElement) {
      const panel = item.querySelector<HTMLElement>('.honey-cake__hotspot-panel');
      if (!panel) return;

      if (!window.matchMedia('(max-width: 39.9375rem)').matches) {
        panel.style.removeProperty('left');
        panel.style.removeProperty('right');
        panel.style.removeProperty('transform');
        return;
      }

      const gutter = 20;
      panel.style.left = `${gutter - item.getBoundingClientRect().left}px`;
      panel.style.right = 'auto';
      panel.style.transform = 'none';
    }
  }

  if (!customElements.get('honey-cake-hotspots')) {
    customElements.define('honey-cake-hotspots', HoneyCakeHotspots);
  }

</script>

<style>
  .honey-cake {
    --honey-cake-scallop-height: 1.15625rem;
    --honey-cake-scallop-width: 2.0625rem;
    --honey-cake-scallop-tile-height: 2.3125rem;
    --honey-cake-surface-start: 11rem;

    position: relative;
    isolation: isolate;
    overflow: clip;
    background: var(--page);
    padding-block: 4.25rem 5rem;
  }

  .honey-cake__surface {
    position: absolute;
    z-index: -2;
    inset: calc(var(--honey-cake-surface-start) + var(--honey-cake-scallop-height)) 0
      var(--honey-cake-scallop-height);
    background: #f8f4f0;
  }

  .honey-cake__container {
    width: min(calc(100% - 2.5rem), 77.5rem);
    margin-inline: auto;
  }

  .honey-cake__title {
    font-family: 'Vetrino', Georgia, serif;
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: 400;
    line-height: 1;
    text-align: center;
    text-wrap: balance;
  }

  .honey-cake__brand-z {
    font-family: 'Bergamasco', Georgia, serif;
  }

  .honey-cake__content {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .honey-cake__media {
    position: relative;
    display: block;
    width: min(100%, 42rem);
    margin-inline: auto;
  }

  .honey-cake__media > picture,
  .honey-cake__media :global(picture) {
    display: block;
  }

  .honey-cake__media :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .honey-cake__hotspot {
    position: absolute;
    z-index: 2;
    top: var(--hotspot-y);
    left: var(--hotspot-x);
    width: 0;
    height: 0;
  }

  .honey-cake__hotspot[open] {
    z-index: 3;
  }

  .honey-cake__hotspot > summary {
    position: absolute;
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    transform: translate(-50%, -50%);
    cursor: pointer;
    list-style: none;
  }

  .honey-cake__hotspot > summary::-webkit-details-marker {
    display: none;
  }

  .honey-cake__hotspot > summary::marker {
    content: '';
  }

  .honey-cake__hotspot-mark {
    display: grid;
    width: 1.0625rem;
    height: 1.0625rem;
    place-items: center;
    border: 1px solid var(--accent);
    border-radius: 50%;
    background: var(--text-primary);
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1;
    transition: background-color 180ms ease, transform 180ms var(--motion-ease);
  }

  .honey-cake__hotspot > summary:hover .honey-cake__hotspot-mark,
  .honey-cake__hotspot[open] .honey-cake__hotspot-mark {
    background: var(--accent-muted);
    transform: scale(1.1);
  }

  .honey-cake__hotspot > summary:focus-visible {
    outline: none;
  }

  .honey-cake__hotspot > summary:focus-visible .honey-cake__hotspot-mark {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
  }

  .honey-cake__hotspot-panel {
    position: absolute;
    width: min(var(--hotspot-width), calc(100vw - 2.5rem));
    border-radius: 0.625rem;
    background: var(--surface-elevated);
    padding: 0.75rem 0.875rem;
    color: var(--text-primary);
    box-shadow: 0 0.625rem 1.75rem rgb(59 38 39 / 16%);
    animation: honey-cake-popover-in 180ms ease both;
  }

  .honey-cake__hotspot[data-placement='top'] .honey-cake__hotspot-panel {
    bottom: 1.125rem;
    left: 50%;
    transform: translateX(-50%);
  }

  .honey-cake__hotspot[data-placement='bottom-right'] .honey-cake__hotspot-panel {
    top: 1.125rem;
    left: -2.5rem;
  }

  .honey-cake__hotspot[data-placement='bottom-left'] .honey-cake__hotspot-panel {
    top: 1.125rem;
    right: -9.75rem;
  }

  @media (max-width: 39.9375rem) {
    .honey-cake__hotspot[data-placement='top'] .honey-cake__hotspot-panel {
      top: 1.125rem;
      bottom: auto;
    }
  }

  .honey-cake__hotspot-panel h3 {
    margin: 0;
    font-size: 0.875rem;
    font-style: italic;
    font-weight: 600;
    line-height: 1.3;
    text-align: center;
  }

  .honey-cake__hotspot-panel p {
    margin: 0.375rem 0 0;
    font-size: 0.875rem;
    line-height: 1.3;
  }

  .honey-cake__hint {
    order: 2;
    margin: 0;
    color: color-mix(in srgb, var(--text-primary) 50%, transparent);
    font-size: 0.875rem;
    font-style: italic;
    font-weight: 500;
    line-height: 1.3;
    text-align: center;
  }

  .honey-cake__copy {
    min-width: 0;
  }

  .honey-cake__copy h3 {
    margin: 0;
    font-family: 'Vetrino', Georgia, serif;
    font-size: 1.875rem;
    font-weight: 400;
    line-height: 1;
  }

  .honey-cake__copy p {
    margin: 1rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.35;
  }

  .honey-cake__copy p + p {
    margin-top: 0.875rem;
  }

  .honey-cake__copy :global(.action-link) {
    margin-top: 1.5rem;
  }

  .honey-cake__scallop {
    position: absolute;
    z-index: -1;
    right: 0;
    left: 0;
    height: var(--honey-cake-scallop-height);
    background: #f8f4f0;
    -webkit-mask: url('/hero/scallop-tile.svg') center top / var(--honey-cake-scallop-width)
      var(--honey-cake-scallop-tile-height) repeat-x;
    mask: url('/hero/scallop-tile.svg') center top / var(--honey-cake-scallop-width)
      var(--honey-cake-scallop-tile-height) repeat-x;
    pointer-events: none;
  }

  .honey-cake__scallop--top {
    top: var(--honey-cake-surface-start);
  }

  .honey-cake__scallop--bottom {
    bottom: 0;
    transform: scaleY(-1);
  }

  .honey-cake__hotspot-content {
    animation: honey-cake-content-in 240ms var(--motion-ease) both;
  }

  @keyframes honey-cake-content-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes honey-cake-popover-in {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @media (min-width: 40rem) {
    .honey-cake {
      --honey-cake-surface-start: 12.25rem;

      padding-block: 5.5rem 6rem;
    }

    .honey-cake__content {
      gap: 1.5rem;
      margin-top: 2.75rem;
    }

    .honey-cake__hint {
      font-size: 1rem;
    }

    .honey-cake__hotspot-panel {
      padding: 0.9375rem 1.25rem;
    }

    .honey-cake__hotspot-panel h3,
    .honey-cake__hotspot-panel p {
      font-size: 1rem;
      line-height: 1.21;
    }

    .honey-cake__copy h3 {
      font-size: 2rem;
    }

    .honey-cake__copy p {
      font-size: 1rem;
      line-height: 1.21;
    }
  }

  @media (min-width: 56.25rem) {
    .honey-cake {
      --honey-cake-scallop-height: 1.44625rem;
      --honey-cake-scallop-width: 2.5625rem;
      --honey-cake-scallop-tile-height: 2.8925rem;
    }
  }

  @media (min-width: 64rem) {
    .honey-cake {
      --honey-cake-surface-start: 12.3125rem;

      min-height: 48.5625rem;
      padding-block: 7.4375rem 2.25rem;
    }

    .honey-cake__title {
      font-size: 3rem;
    }

    .honey-cake__content {
      grid-template-columns: minmax(0, 1fr) 24.1875rem;
      column-gap: clamp(2rem, 6vw, 6.25rem);
      row-gap: 0;
      margin-top: 6.625rem;
    }

    .honey-cake__media {
      grid-column: 1;
      grid-row: 1;
      width: min(100%, 43rem);
      margin: 0;
    }

    .honey-cake__hotspot-panel {
      width: clamp(var(--hotspot-width), 20vw, 26rem);
    }

    .honey-cake__hint {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-top: 1.25rem;
    }

    .honey-cake__copy {
      grid-column: 2;
      grid-row: 1;
      align-self: center;
    }

    .honey-cake__copy h3 {
      font-size: 1.875rem;
    }

    .honey-cake__copy :global(.action-link) {
      margin-top: 2.25rem;
    }
  }

  @media (min-width: 75rem) {
    .honey-cake {
      --honey-cake-scallop-height: 2.03125rem;
      --honey-cake-scallop-width: 3.6rem;
      --honey-cake-scallop-tile-height: 4.0625rem;
    }
  }

  @media (min-width: 90rem) {
    .honey-cake__content {
      grid-template-columns: 43rem 24.1875rem;
      justify-content: center;
      column-gap: 4.5rem;
    }

    .honey-cake__media {
      width: 43rem;
    }
  }
</style>
