---
import PurchaseCard from './PurchaseCard.astro';
import { PURCHASE_OPTIONS } from '@/lib/purchase';
import { HOME_SECTION_IDS } from '@/lib/site';
---

<section id={HOME_SECTION_IDS.whereToBuy} class="where-to-buy" data-section-spacing-target aria-labelledby="where-to-buy-title">
  <div class="where-to-buy__inner">
    <h2 id="where-to-buy-title" class="where-to-buy__title" data-section-title data-motion="heading">
      Где купить торты и десерты от ZOTOV bakery
    </h2>

    <div
      class="where-to-buy__track"
      data-section-end
      aria-label="Способы покупки тортов и десертов ZOTOV bakery"
    >
      {
        PURCHASE_OPTIONS.map((option) => <PurchaseCard option={option} />)
      }
    </div>
  </div>
</section>

<style>
  .where-to-buy {
    overflow: hidden;
    background: var(--page);
    padding-block: clamp(4.5rem, 8vw, 5.9375rem) clamp(4.5rem, 8vw, 7.5625rem);
  }

  .where-to-buy__inner {
    width: min(calc(100% - 32px), 704px);
    margin-inline: auto;
  }

  .where-to-buy__title {
    width: 100%;
    margin-inline: auto;
    color: var(--text-primary);
    font-family: 'Vetrino', 'Vetrino Fallback', Georgia, serif;
    font-size: clamp(1.5rem, calc(1.1131rem + 1.5873vw), 1.875rem);
    font-weight: 400;
    line-height: 1.05;
    text-align: center;
  }

  .where-to-buy__track {
    display: grid;
    gap: 1.25rem;
    width: 100%;
    margin: 2.5rem auto 0;
    outline-offset: 0.5rem;
  }

  @media (min-width: 768px) {
    .where-to-buy__inner {
      width: min(calc(100% - 40px), 1240px);
    }

    .where-to-buy__track {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: stretch;
    }
  }

  @media (min-width: 48rem) and (max-width: 63.999rem) {
    .where-to-buy__title {
      font-size: clamp(1.875rem, 3.9063vw, 2.5rem);
      line-height: 1;
    }
  }

  @media (min-width: 64rem) and (max-width: 74.999rem) {
    .where-to-buy__title {
      font-size: clamp(2.5rem, calc(-0.4091rem + 4.5455vw), 3rem);
      line-height: 1;
    }
  }

  @media (min-width: 1200px) {
    .where-to-buy {
      padding-block: 5.9375rem 7.5rem;
    }

    .where-to-buy__track {
      grid-template-columns: minmax(0, 334fr) repeat(2, minmax(0, 443fr));
      grid-template-rows: repeat(2, minmax(229px, auto));
      gap: 10px;
      margin-top: 66px;
    }

    .where-to-buy__title {
      font-size: 48px;
    }
  }
</style>
