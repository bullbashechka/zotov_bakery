---
import PurchaseCard from './PurchaseCard.astro';
import Wrapper from './Wrapper.astro';
import { PURCHASE_OPTIONS } from '@/lib/purchase';
import { HOME_SECTION_IDS } from '@/lib/site';
---

<section id={HOME_SECTION_IDS.whereToBuy} class="where-to-buy" data-section-spacing-target aria-labelledby="where-to-buy-title">
  <div class="where-to-buy__inner">
    <h2 id="where-to-buy-title" class="where-to-buy__title" data-section-title data-motion="heading">
      Где купить торты и десерты от ZOTOV bakery
    </h2>

    <div
      class="where-to-buy__track"
      data-section-end
      aria-label="Способы покупки тортов и десертов ZOTOV bakery"
    >
      {
        PURCHASE_OPTIONS.map((option) => (
          <Wrapper
            at={{
              tablet: {
                display: 'flex',
                dir: 'column',
                alignSelf: 'stretch',
                column: option.kind === 'delivery' ? '1 / -1' : 'auto',
                height: '100%',
                margin: '0',
              },
              desktop: {
                display: 'block',
                height: 'auto',
                column: 'auto',
              },
            }}
          >
            <PurchaseCard option={option} />
          </Wrapper>
        ))
      }
    </div>
  </div>
</section>

<style>
  .where-to-buy {
    overflow: hidden;
    background: var(--page);
    padding-block: clamp(4.5rem, 8vw, 5.9375rem) clamp(4.5rem, 8vw, 7.5625rem);
  }

  .where-to-buy__inner {
    width: min(100%, 77.5rem);
    margin-inline: auto;
  }

  .where-to-buy__title {
    width: min(calc(100% - 2rem), 72.125rem);
    margin-inline: auto;
    color: var(--text-primary);
    font-family: 'Vetrino', Georgia, serif;
    font-size: clamp(1.5rem, calc(1.1131rem + 1.5873vw), 1.875rem);
    font-weight: 400;
    line-height: 1.05;
    text-align: center;
  }

  .where-to-buy__track {
    display: grid;
    gap: 1.25rem;
    width: min(calc(100% - 2rem), 25rem);
    margin: 2.5rem auto 0;
    outline-offset: 0.5rem;
  }

  @media (min-width: 40rem) and (max-width: 74.999rem) {
    .where-to-buy {
      overflow: hidden;
    }

    .where-to-buy__track {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: min(calc(100% - 4rem), 52.5rem);
      margin-top: 2.5rem;
      align-items: stretch;
      overflow: visible;
    }
  }

  @media (min-width: 48rem) and (max-width: 63.999rem) {
    .where-to-buy__title {
      font-size: clamp(1.875rem, 3.9063vw, 2.5rem);
      line-height: 1;
    }
  }

  @media (min-width: 64rem) and (max-width: 74.999rem) {
    .where-to-buy__title {
      font-size: clamp(2.5rem, calc(-0.4091rem + 4.5455vw), 3rem);
      line-height: 1;
    }
  }

  @media (min-width: 75rem) {
    .where-to-buy {
      padding-block: 5.9375rem 7.5rem;
    }

    .where-to-buy__inner {
      width: min(calc(100% - 2.5rem), 77.5rem);
    }

    .where-to-buy__track {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 100%;
      gap: 1.25rem;
      margin-top: 2.4375rem;
    }

    .where-to-buy__title {
      font-size: 3rem;
    }
  }
</style>
