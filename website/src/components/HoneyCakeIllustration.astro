---
import { Picture } from 'astro:assets';
import honeyCake from '@/assets/honey-cake-transparent.png';

type Hotspot = {
  id: string;
  title: string;
  body: string;
};

const hotspots: Hotspot[] = [
  {
    id: 'protein-cream',
    title: 'Белковый крем',
    body: 'Воздушный и нежный. Добавляет медовику лёгкости и мягко дополняет сладость коржей.',
  },
  {
    id: 'honey-layers',
    title: 'Медовые коржи',
    body: 'Мягкие, хорошо пропитанные, с медовым ароматом. Именно они дают десерту тот самый домашний вкус.',
  },
  {
    id: 'cream',
    title: 'Крем',
    body: 'Соединяет коржи и делает их ещё мягче. Благодаря ей медовик получается нежным и хорошо пропитанным.',
  },
];
---

<honey-cake-hotspots class="honey-cake__media" data-motion="image">
  <Picture
    src={honeyCake}
    formats={['avif', 'webp']}
    widths={[320, 480, 640, 768, 934]}
    sizes="(max-width: 47.999rem) min(100vw - 2.5rem, 35rem), (max-width: 63.999rem) calc((100vw - 4rem) * 0.65), min(54vw, 43rem)"
    alt="Медовик ZOTOV bakery с белковым кремом и цветочным оформлением"
    loading="lazy"
  />

  {
    hotspots.map((hotspot) => {
      const summaryId = `honey-cake-${hotspot.id}-summary`;
      const panelId = `honey-cake-${hotspot.id}-panel`;

      return (
        <details class="honey-cake__hotspot" data-ingredient={hotspot.id}>
          <summary id={summaryId} aria-controls={panelId}>
            <span class="sr-only">Подробнее: {hotspot.title}</span>
            <span class="honey-cake__hotspot-mark" aria-hidden="true">
              +
            </span>
          </summary>
          <div
            id={panelId}
            class="honey-cake__hotspot-panel"
            role="region"
            aria-labelledby={summaryId}
          >
            <div class="honey-cake__hotspot-content">
              <h3>{hotspot.title}</h3>
              <p>{hotspot.body}</p>
            </div>
          </div>
        </details>
      );
    })
  }
</honey-cake-hotspots>

<script>
  import { gsap } from 'gsap';

  class HoneyCakeHotspots extends HTMLElement {
    private items: HTMLDetailsElement[] = [];
    private abortController: AbortController | null = null;
    private scenes = new Map<HTMLDetailsElement, gsap.core.Timeline>();
    private reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    private frame = 0;

    connectedCallback() {
      if (this.abortController) return;

      this.abortController = new AbortController();
      const { signal } = this.abortController;
      this.items = Array.from(this.querySelectorAll<HTMLDetailsElement>('.honey-cake__hotspot'));

      this.items.forEach((item) => {
        item.addEventListener('toggle', this.handleToggle, { signal });
      });
      document.addEventListener('pointerdown', this.handlePointerDown, { signal });
      document.addEventListener('keydown', this.handleKeydown, { signal });
      window.addEventListener('resize', this.handleResize, { signal });
      this.reduced.addEventListener(
        'change',
        () => {
          if (this.reduced.matches) this.scenes.forEach((scene) => scene.progress(1).kill());
        },
        { signal },
      );
    }

    disconnectedCallback() {
      this.abortController?.abort();
      this.abortController = null;
      cancelAnimationFrame(this.frame);
      this.scenes.forEach((scene) => scene.revert());
      this.scenes.clear();
      this.items = [];
    }

    private handleToggle = (event: Event) => {
      const current = event.currentTarget as HTMLDetailsElement;
      current.dataset.expanded = String(current.open);
      this.scenes.get(current)?.revert();
      this.scenes.delete(current);
      if (!current.open) return;

      this.items.forEach((item) => {
        if (item !== current) {
          this.scenes.get(item)?.revert();
          this.scenes.delete(item);
          item.open = false;
        }
      });
      cancelAnimationFrame(this.frame);
      this.positionMobilePanel(current);
      if (this.reduced.matches) return;
      const content = current.querySelector('.honey-cake__hotspot-content');
      const mark = current.querySelector('.honey-cake__hotspot-mark');
      if (!content || !mark) return;
      const scene = gsap
        .timeline()
        .fromTo(mark, { rotation: 0 }, { rotation: 45, duration: 0.22 }, 0)
        .fromTo(
          content,
          { y: 8, opacity: 0 },
          { y: 0, opacity: 1, duration: 0.24, ease: 'power2.out' },
          0.1,
        );
      this.scenes.set(current, scene);
    };

    private handlePointerDown = (event: PointerEvent) => {
      if (this.contains(event.target as Node)) return;
      this.closeAll();
    };

    private handleKeydown = (event: KeyboardEvent) => {
      if (event.key !== 'Escape') return;

      const active = this.items.find((item) => item.open);
      if (!active) return;

      event.preventDefault();
      active.open = false;
      active.querySelector<HTMLElement>('summary')?.focus();
    };

    private closeAll() {
      this.items.forEach((item) => {
        item.open = false;
      });
    }

    private handleResize = () => {
      const active = this.items.find((item) => item.open);
      if (active) {
        this.scenes.get(active)?.progress(1);
        cancelAnimationFrame(this.frame);
        this.frame = requestAnimationFrame(() => {
          this.positionMobilePanel(active);
        });
      }
    };

    private positionMobilePanel(item: HTMLDetailsElement) {
      const panel = item.querySelector<HTMLElement>('.honey-cake__hotspot-panel');
      if (!panel) return;

      if (!window.matchMedia('(max-width: 39.9375rem)').matches) {
        panel.style.removeProperty('left');
        panel.style.removeProperty('right');
        panel.style.removeProperty('transform');
        panel.style.removeProperty('top');
        panel.style.removeProperty('bottom');
        return;
      }

      const gutter = 20;
      panel.style.left = `${gutter - item.getBoundingClientRect().left}px`;
      panel.style.right = 'auto';
      panel.style.transform = 'none';
      const lowestPoint = Math.max(...this.items.map((point) => point.getBoundingClientRect().top));
      panel.style.top = `${lowestPoint - item.getBoundingClientRect().top + 28}px`;
      panel.style.bottom = 'auto';
    }
  }

  if (!customElements.get('honey-cake-hotspots')) {
    customElements.define('honey-cake-hotspots', HoneyCakeHotspots);
  }
</script>

<style>
  .honey-cake__hotspot[open] .honey-cake__hotspot-mark {
    transform: rotate(45deg) scale(1.1);
  }

  .honey-cake__media {
    position: relative;
    display: block;
    padding: 12% 12% 4%;
  }

  .honey-cake__media > picture,
  .honey-cake__media :global(picture) {
    display: block;
  }

  .honey-cake__media :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .honey-cake__hotspot {
    position: absolute;
    z-index: 2;
    top: var(--hotspot-y);
    left: var(--hotspot-x);
    width: 0;
    height: 0;
  }

  .honey-cake__hotspot[open] {
    z-index: 3;
  }

  .honey-cake__hotspot > summary {
    position: absolute;
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    transform: translate(-50%, -50%);
    cursor: pointer;
    list-style: none;
  }

  .honey-cake__hotspot > summary::-webkit-details-marker {
    display: none;
  }

  .honey-cake__hotspot > summary::marker {
    content: '';
  }

  .honey-cake__hotspot-mark {
    display: grid;
    width: 1.0625rem;
    height: 1.0625rem;
    place-items: center;
    border: 1px solid var(--accent);
    border-radius: 50%;
    background: var(--text-primary);
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1;
    transition: background-color 180ms ease;
  }

  .honey-cake__hotspot > summary:hover .honey-cake__hotspot-mark {
    background: var(--accent-muted);
  }

  .honey-cake__hotspot > summary:focus-visible {
    outline: none;
  }

  .honey-cake__hotspot > summary:focus-visible .honey-cake__hotspot-mark {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
  }

  .honey-cake__hotspot-panel {
    position: absolute;
    width: min(var(--hotspot-width), calc(100vw - 2.5rem));
    border-radius: 0.625rem;
    background: var(--surface-elevated);
    padding: 0.75rem 0.875rem;
    color: var(--text-primary);
    box-shadow: 0 0.625rem 1.75rem rgb(59 38 39 / 16%);
  }

  .honey-cake__hotspot[data-ingredient='protein-cream'] .honey-cake__hotspot-panel {
    bottom: 1.125rem;
    left: 50%;
    transform: translateX(-50%);
  }

  .honey-cake__hotspot[data-ingredient='honey-layers'] .honey-cake__hotspot-panel {
    top: 1.125rem;
    left: -2.5rem;
  }

  .honey-cake__hotspot[data-ingredient='cream'] .honey-cake__hotspot-panel {
    top: 1.125rem;
    right: -9.75rem;
  }

  @media (max-width: 39.9375rem) {
    .honey-cake__hotspot[data-ingredient='protein-cream'] .honey-cake__hotspot-panel {
      top: 1.125rem;
      bottom: auto;
    }
  }

  .honey-cake__hotspot-panel h3 {
    margin: 0;
    font-size: 0.875rem;
    font-style: italic;
    font-weight: 600;
    line-height: 1.3;
    text-align: center;
  }

  .honey-cake__hotspot-panel p {
    margin: 0.375rem 0 0;
    font-size: 0.875rem;
    line-height: 1.3;
  }

  @media (min-width: 40rem) {
    .honey-cake__hotspot-panel {
      padding: 0.9375rem 1.25rem;
    }

    .honey-cake__hotspot-panel h3,
    .honey-cake__hotspot-panel p {
      font-size: 1rem;
      line-height: 1.21;
    }
  }

  @media (48rem <= width < 64rem) {
    .honey-cake__media {
      /* Compensate for the transparent margins around the cake artwork. */
      width: 130%;
      margin-inline: -15%;
    }

    .honey-cake__hotspot[data-ingredient] .honey-cake__hotspot-panel {
      top: auto;
      right: -3.5rem;
      bottom: 1.125rem;
      left: auto;
      width: 14rem;
      padding: 0.625rem 0.75rem;
      transform: none;
    }

    .honey-cake__hotspot-panel h3,
    .honey-cake__hotspot-panel p {
      font-size: 0.8125rem;
      line-height: 1.2;
    }
  }

  @media (min-width: 64rem) {
    .honey-cake__media {
      position: relative;
      display: block;
    }

    .honey-cake__hotspot-panel {
      width: clamp(var(--hotspot-width), calc(var(--layout-viewport) * 0.2), 26rem);
    }
  }

  @media (min-width: 90rem) {
    .honey-cake__media {
      position: relative;
      display: block;
    }
  }

  [data-ingredient='protein-cream'] {
    --hotspot-x: 76%;
    --hotspot-y: 46%;
    --hotspot-width: 326px;
  }
  [data-ingredient='honey-layers'] {
    --hotspot-x: 75%;
    --hotspot-y: 64%;
    --hotspot-width: 395px;
  }
  [data-ingredient='cream'] {
    --hotspot-x: 61%;
    --hotspot-y: 62%;
    --hotspot-width: 384px;
  }
</style>
