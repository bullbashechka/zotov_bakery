---
import FaqAccordion from './FaqAccordion.astro';
import Wrapper from './Wrapper.astro';
import { FAQ_ITEMS } from '@/lib/faq';
import { HOME_SECTION_IDS } from '@/lib/site';
---

<section id={HOME_SECTION_IDS.faq} class="faq" data-section-spacing-target aria-labelledby="faq-title">
  <div class="faq__container">
    <h2 id="faq-title" class="faq__title" data-section-title data-motion="heading">Частые вопросы</h2>

    <Wrapper margin="2rem 0 0">
      <FaqAccordion items={FAQ_ITEMS} />
    </Wrapper>
  </div>

  <div class="faq__background" aria-hidden="true"></div>
</section>

<style>
  .faq {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--page);
    padding-block: 3.5rem 5rem;
  }

  .faq__container {
    position: relative;
    z-index: 1;
    width: min(calc(100% - 2.5rem), 77.5rem);
    margin-inline: auto;
  }

  .faq__background {
    position: absolute;
    z-index: 0;
    inset: 0;
    background: url('/faq/union.svg') center / cover no-repeat;
    pointer-events: none;
  }

  .faq__title {
    font-family: 'Vetrino', Georgia, serif;
    font-size: clamp(1.5rem, calc(1.1131rem + 1.5873vw), 1.875rem);
    font-weight: 400;
    line-height: 1.05;
    text-align: center;
    text-wrap: balance;
  }

  @media (min-width: 48rem) and (max-width: 63.999rem) {
    .faq__title {
      font-size: clamp(1.875rem, 3.9063vw, 2.5rem);
      line-height: 1;
    }
  }

  @media (min-width: 64rem) and (max-width: 79.999rem) {
    .faq__title {
      font-size: clamp(2.5rem, calc(0.5rem + 3.125vw), 3rem);
      line-height: 1;
    }
  }

  @media (min-width: 80rem) {
    .faq {
      min-height: 49.25rem;
      padding-block: 3.1875rem 5.8125rem;
    }

    .faq__background {
      background-size: 100% 100%;
    }

    .faq__title {
      font-size: 3rem;
    }
  }
</style>
