---
import ContactSection from '@/components/ContactSection.astro';
import FooterLogo from './FooterLogo.astro';
import FooterNavigation from './FooterNavigation.astro';
import Copyright from './Copyright.astro';
import Wrapper from './Wrapper.astro';

const analyticsEnabled = Boolean(import.meta.env.PUBLIC_YANDEX_METRIKA_ID?.trim());
---

<div class="site-footer__surface">
  <div class="site-footer__content">
    <Wrapper
      column="1 / -1"
      order={1}
      at={{
        tablet: { column: '2', row: '1' },
        laptop: { column: '2', row: '1', width: 'calc(100% + 0.6875rem)' },
        desktop: { column: '2', row: '1', width: '100%' },
      }}
    >
      <ContactSection />
    </Wrapper>

    <Wrapper
      column="1 / -1"
      order={2}
      display="flex"
      dir="column"
      align="center"
      justify="center"
      justifySelf="center"
      width="9.4375rem"
      at={{
        tablet: { column: '1', row: '1', align: 'center', width: '9.4375rem' },
        laptop: {
          column: '1',
          row: '1',
          align: 'center',
          justify: 'center',
          justifySelf: 'start',
          width: '17.6rem',
          margin: '0 0 0 0.5625rem',
        },
        desktop: {
          column: '1',
          row: '1 / span 3',
          align: 'center',
          justifySelf: 'start',
          width: '392px',
          margin: '0',
        },
      }}
    >
      <FooterLogo />
    </Wrapper>

    <Wrapper
      column="1 / -1"
      order={3}
      at={{
        tablet: { column: '1 / -1', row: '2', margin: '2.125rem 0 0' },
        medium: { column: '1 / -1', row: '2', margin: '2.125rem 0 0' },
        desktop: { column: '2', row: '2', margin: '5px 0 0' },
      }}
    >
      <FooterNavigation variant="primary" />
    </Wrapper>
    <Wrapper
      column="1 / -1"
      order={4}
      margin="0"
      at={{ tablet: { column: '1 / -1', row: '3' }, desktop: { column: '2', row: '3', margin: '0' } }}
    >
      <FooterNavigation variant="legal" />
    </Wrapper>
    {
      analyticsEnabled && (
        <Wrapper
          column="1 / -1"
          order={5}
          margin="0"
          at={{ tablet: { column: '1 / -1', row: '4' }, desktop: { column: '2', row: '4' } }}
        >
          <button class="site-footer__cookie-settings" type="button" data-cookie-settings>
            Настройки cookie
          </button>
        </Wrapper>
      )
    }
    <Wrapper
      column="1 / -1"
      order={6}
      margin="0.25rem 0 0"
      at={{ tablet: { column: '1 / -1', row: '5' }, desktop: { column: '2', row: '5' } }}
    >
      <Copyright />
    </Wrapper>
  </div>
</div>

<style>
  .site-footer__surface {
    overflow: visible;
    overflow-x: clip;
    position: relative;
    z-index: 1;
    background: transparent;
    color: var(--text-primary);
    padding: 1rem 0 2.5rem;
  }

  .site-footer__cookie-settings {
    display: block;
    min-height: 1.75rem;
    margin-inline: auto;
    border: 0;
    border-radius: 0.25rem;
    background: transparent;
    color: inherit;
    padding: 0.25rem;
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .site-footer__content {
    display: grid;
    width: min(calc(100% - 2rem), 77.5rem);
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin-inline: auto;
  }

  @media (min-width: 40rem) {
    .site-footer__surface {
      padding-bottom: 3.5rem;
    }

    .site-footer__content {
      width: min(calc(100% - 4.5rem), 77.5rem);
      grid-template-columns: 9.4375rem minmax(0, calc(100% - 10.6875rem));
      gap: 1rem;
    }
  }

  @media (min-width: 40rem) and (max-width: 74.999rem) {
    .site-footer__logo {
      transform: translateY(1.625rem);
    }
  }

  @media (min-width: 56.25rem) and (max-width: 74.999rem) {
    .site-footer__content {
      width: min(calc(100% - 7.5rem), 56.625rem);
      grid-template-columns: 17.6rem minmax(0, 1fr);
      column-gap: 5rem;
      row-gap: 0.6875rem;
    }
  }

  @media (min-width: 75rem) {
    .site-footer__surface {
      padding: 44px 0 48px;
    }

    .site-footer__content {
      width: min(calc(100% - 260px), 1180px);
      grid-template-columns: 392px 662px;
      column-gap: 84px;
      row-gap: 17px;
    }

    .site-footer__cookie-settings {
      margin-left: 48px;
    }
  }
</style>
