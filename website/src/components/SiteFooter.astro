---
import ContactSection from '@/components/ContactSection.astro';
import FooterLogo from './FooterLogo.astro';
import FooterNavigation from './FooterNavigation.astro';
import Copyright from './Copyright.astro';
import Wrapper from './Wrapper.astro';
---

<div class="site-footer__surface">
  <div class="site-footer__content">
    <Wrapper
      column="1"
      order={2}
      alignSelf="end"
      width="clamp(6.875rem, 31vw, 8.5rem)"
      at={{ desktop: { row: '1 / span 3', alignSelf: 'center', width: 'min(100%, 24.5rem)' } }}
    >
      <FooterLogo />
    </Wrapper>

    <Wrapper column="1 / -1" order={1} at={{ desktop: { column: '2', row: '1' } }}>
      <ContactSection />
    </Wrapper>

    <Wrapper column="2" order={3} at={{ desktop: { row: '2', margin: '0.5rem 0 0' } }}>
      <FooterNavigation variant="primary" />
    </Wrapper>
    <Wrapper
      column="1 / -1"
      order={4}
      margin="0.5rem 0 0"
      at={{ desktop: { column: '2', row: '3', margin: '0' } }}
    >
      <FooterNavigation variant="legal" />
    </Wrapper>
    <Wrapper
      column="1 / -1"
      order={5}
      margin="0.25rem 0 0"
      at={{ desktop: { column: '2', row: '4' } }}
    >
      <Copyright />
    </Wrapper>
  </div>
</div>

<style>
  .site-footer__surface {
    overflow: clip;
    position: relative;
    z-index: 1;
    background: transparent;
    color: var(--text-primary);
    padding: 1rem 0 2.5rem;
  }

  .site-footer__content {
    display: grid;
    width: min(calc(100% - 2rem), 77.5rem);
    grid-template-columns: minmax(6.5rem, 0.8fr) minmax(0, 1.2fr);
    gap: 1.5rem 1rem;
    margin-inline: auto;
  }

  @media (min-width: 40rem) {
    .site-footer__surface {
      padding-bottom: 3.5rem;
    }

    .site-footer__content {
      grid-template-columns: minmax(13rem, 0.9fr) minmax(0, 1.1fr);
      gap: 1.5rem 2.5rem;
    }
  }

  @media (min-width: 75rem) {
    .site-footer__surface {
      overflow: visible;
      padding-block: 2rem 3rem;
    }

    .site-footer__content {
      grid-template-columns: minmax(20rem, 0.8fr) minmax(0, 1.2fr);
      gap: 1.25rem 3rem;
    }
  }
</style>
