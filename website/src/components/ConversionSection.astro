---
import { Picture } from 'astro:assets';
import dessertLeft from '@/assets/conversion/dessert-left.png';
import dessertRight from '@/assets/conversion/dessert-right.png';
import selectionFlow from '@/assets/conversion/selection-flow.svg?raw';
import ActionLink from '@/components/ActionLink.astro';
import { getWhatsAppUrl, HOME_SECTION_IDS } from '@/lib/site';

const whatsappUrl = getWhatsAppUrl('selectionHelp');
---

<section
  id={HOME_SECTION_IDS.conversion}
  class="conversion-section"
  data-motion-group
  aria-labelledby="conversion-title"
>
  <div
    class="conversion-section__line"
    data-selection-line
    aria-hidden="true"
    set:html={selectionFlow}
  />

  <div class="conversion-section__inner">
    <div class="conversion-section__copy" data-motion-trigger>
      <h2 id="conversion-title" class="conversion-section__title" data-motion="heading">
        Не знаете что выбрать?
      </h2>
      <p class="conversion-section__description" data-motion="copy">
        Напишите нам в WhatsApp. Подскажем, какие десерты есть в наличии и где их удобнее купить.
      </p>
      <div class="conversion-section__actions">
        <ActionLink variant="primary" href={whatsappUrl} fullWidth external>
          Написать в WhatsApp
        </ActionLink>
        <ActionLink variant="secondary" href={`#${HOME_SECTION_IDS.assortment}`} fullWidth>
          Посмотреть ассортимент
        </ActionLink>
      </div>
    </div>

    <div class="conversion-section__desserts" aria-hidden="true">
      <div
        class="conversion-section__dessert conversion-section__dessert--left"
        data-selection-dessert="left"
      >
        <Picture
          src={dessertLeft}
          formats={['avif', 'webp']}
          widths={[240, 320, 392, 480, 640, 784]}
          sizes="(max-width: 39.999rem) 56vw, (max-width: 74.999rem) 31vw, 31rem"
          alt=""
        />
      </div>
      <div
        class="conversion-section__dessert conversion-section__dessert--right"
        data-selection-dessert="right"
      >
        <Picture
          src={dessertRight}
          formats={['avif', 'webp']}
          widths={[260, 360, 459, 560, 720, 918]}
          sizes="(max-width: 39.999rem) 60vw, (max-width: 74.999rem) 34vw, 35rem"
          alt=""
        />
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { animate, svg } from 'animejs';
  import { mountMotion } from '@/lib/motion-lifecycle';
  const cleanup = mountMotion(
    '.conversion-section',
    ({ element: selection, onceVisible, track, onCleanup }) => {
      const path = selection.querySelector<SVGPathElement>('[data-selection-line] path');
      if (path) {
        const crumb = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        crumb.setAttribute('r', '9');
        crumb.setAttribute('fill', '#6b3e22');
        crumb.style.opacity = '0';
        path.parentElement?.append(crumb);
        onCleanup(() => crumb.remove());
        onceVisible(() => {
          const drawing = animate(svg.createDrawable(path), {
            draw: ['0 0', '0 1'],
            duration: 1200,
            ease: 'inOutQuad',
          });
          track(drawing);
          crumb.style.opacity = '1';
          track(
            animate(crumb, {
              ...svg.createMotionPath(path),
              duration: 1200,
              ease: 'inOutQuad',
              onComplete: () => {
                crumb.style.opacity = '0';
              },
            }),
          );
          const desserts = selection.querySelectorAll('[data-selection-dessert]');
          gsap.fromTo(
            desserts,
            { y: innerWidth < 768 ? 12 : 24, opacity: 0, rotation: (i: number) => (i ? 3 : -3) },
            {
              y: 0,
              opacity: 1,
              rotation: 0,
              duration: 1,
              ease: 'back.out(1.1)',
              clearProps: 'transform,opacity',
            },
          );
          const button = selection.querySelector('.action-link');
          button?.dispatchEvent(new Event('action-emphasis'));
        });
      }
    },
  );
  if (import.meta.hot) import.meta.hot.dispose(cleanup);

  document
    .querySelectorAll<HTMLAnchorElement>('.conversion-section a[href^="#"]')
    .forEach((link) => {
      link.addEventListener('click', () => {
        const target = document.getElementById((link.getAttribute('href') ?? '').slice(1));
        const heading = target?.querySelector<HTMLElement>('h1, h2, h3');
        if (!heading) return;
        heading.setAttribute('tabindex', '-1');
        heading.focus({ preventScroll: true });
      });
    });
</script>

<style>
  .conversion-section {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    overflow-y: visible;
    background: transparent;
    padding-block: clamp(4.5rem, 8vw, 7.5rem) clamp(4.5rem, 7vw, 6.5rem);
  }

  .conversion-section__line {
    position: absolute;
    z-index: 0;
    top: 3rem;
    left: 0;
    width: 100%;
    height: max(17.65625rem, 41.475vw);
    overflow: clip;
    pointer-events: none;
  }

  .conversion-section__line :global(svg) {
    position: absolute;
    top: 0;
    left: 50%;
    display: block;
    width: max(46rem, 108vw);
    height: auto;
    overflow: visible;
    transform: translate(-50%, 2.375rem);
  }

  .conversion-section__inner {
    position: relative;
    z-index: 1;
    width: min(calc(100% - 2rem), 77.5rem);
    min-height: auto;
    margin-inline: auto;
  }

  .conversion-section__copy {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    max-width: 32.1875rem;
    margin-inline: auto;
    text-align: center;
  }

  .conversion-section__title {
    display: inline-block;
    background: var(--text-primary);
    color: var(--surface-elevated);
    padding: 0.625rem clamp(1rem, 3vw, 1.625rem);
    font-family: 'Vetrino', Georgia, serif;
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: 400;
    line-height: 1;
  }

  .conversion-section__description {
    max-width: 32.1875rem;
    margin-top: 1.75rem;
    font-size: 1rem;
    line-height: 1.1;
  }

  .conversion-section__actions {
    display: grid;
    width: min(100%, 18.25rem);
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .conversion-section__desserts {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 2.5rem calc(50% - 50vw) 0;
    padding-inline: max(0.25rem, calc((100vw - 22rem) / 2));
    pointer-events: none;
  }

  .conversion-section__dessert {
    display: block;
    flex: 0 1 auto;
  }

  .conversion-section__dessert :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .conversion-section__dessert--left {
    width: min(56vw, 17rem);
  }

  .conversion-section__dessert--right {
    width: min(60vw, 18rem);
  }

  @media (max-width: 39.999rem) {
    .conversion-section__desserts {
      display: none;
    }
  }

  @media (min-width: 40rem) {
    .conversion-section__inner {
      min-height: 27rem;
    }

    .conversion-section__copy {
      padding-top: 0.5rem;
    }

    .conversion-section__desserts {
      position: absolute;
      inset: 2.75rem -2rem auto;
      display: block;
      margin: 0;
      padding: 0;
    }

    .conversion-section__dessert {
      position: absolute;
    }

    .conversion-section__dessert--left {
      top: 1.5rem;
      left: 0;
      width: min(31vw, 24.5rem);
    }

    .conversion-section__dessert--right {
      top: 3.75rem;
      right: 0;
      width: min(34vw, 28.7rem);
    }
  }

  @media (min-width: 75rem) {
    .conversion-section__line {
      top: 4.3125rem;
    }

    .conversion-section__line :global(svg) {
      left: 51.75%;
      transform: translate(calc(-50% - 5rem), 2.375rem);
    }

    .conversion-section__inner {
      min-height: 25rem;
    }

    .conversion-section__desserts {
      inset-inline: -3.125rem;
    }

    .conversion-section__dessert--left {
      top: 0.65rem;
    }

    .conversion-section__dessert--right {
      top: 2.25rem;
    }
  }
</style>
