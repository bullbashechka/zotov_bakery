---
import { Picture } from 'astro:assets';
import dessertLeft from '@/assets/conversion/dessert-left.png';
import dessertRight from '@/assets/conversion/dessert-right.png';
import selectionFlow from '@/assets/conversion/selection-flow.svg?raw';
import ActionLink from '@/components/ActionLink.astro';
import { getWhatsAppUrl, HOME_SECTION_IDS } from '@/lib/site';

const whatsappUrl = getWhatsAppUrl('selectionHelp');
---

<section id={HOME_SECTION_IDS.conversion} class="conversion-section" aria-labelledby="conversion-title">
  <div class="conversion-section__line" data-conversion-line aria-hidden="true" set:html={selectionFlow}></div>

  <div class="conversion-section__inner">
    <div class="conversion-section__copy">
      <h2 id="conversion-title" class="conversion-section__title">Не знаете что выбрать?</h2>
      <p class="conversion-section__description">
        Напишите нам в WhatsApp. Подскажем, какие десерты есть в наличии и где их удобнее купить.
      </p>
      <div class="conversion-section__actions">
        <ActionLink
          variant="primary"
          href={whatsappUrl}
          fullWidth
          target="_blank"
          rel="noopener noreferrer"
        >
          Написать в WhatsApp
        </ActionLink>
        <ActionLink variant="secondary" href={`#${HOME_SECTION_IDS.assortment}`} fullWidth>
          Посмотреть ассортимент
        </ActionLink>
      </div>
    </div>

    <div class="conversion-section__desserts" aria-hidden="true">
      <Picture
        class="conversion-section__dessert conversion-section__dessert--left"
        src={dessertLeft}
        formats={['avif', 'webp']}
        widths={[240, 320, 392, 480, 640, 784]}
        sizes="(max-width: 39.999rem) 56vw, (max-width: 74.999rem) 31vw, 31rem"
        alt=""
      />
      <Picture
        class="conversion-section__dessert conversion-section__dessert--right"
        src={dessertRight}
        formats={['avif', 'webp']}
        widths={[260, 360, 459, 560, 720, 918]}
        sizes="(max-width: 39.999rem) 60vw, (max-width: 74.999rem) 34vw, 35rem"
        alt=""
      />
    </div>
  </div>
</section>

<script>
  const line = document.querySelector<HTMLElement>('[data-conversion-line]');

  if (line && line.dataset.motionReady !== 'true') {
    line.dataset.motionReady = 'true';
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const path = line.querySelector<SVGPathElement>('path');

    line.closest<HTMLElement>('.conversion-section')?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
      link.addEventListener('click', () => {
        window.setTimeout(() => {
          const target = document.querySelector<HTMLElement>(link.getAttribute('href') ?? '');
          target?.focus({ preventScroll: true });
        }, 0);
      });
    });

    if (!path || reducedMotion.matches) {
      line.dataset.drawn = 'true';
    } else {
      const length = path.getTotalLength();
      let started = false;
      let observer: IntersectionObserver | undefined;

      path.style.strokeDasharray = `${length}`;
      path.style.strokeDashoffset = `${-length}`;

      const finish = () => {
        path.style.strokeDashoffset = '0';
        line.dataset.drawn = 'true';
        delete line.dataset.drawing;
      };

      const start = () => {
        if (started || reducedMotion.matches) return;
        started = true;
        line.dataset.drawing = 'true';
        requestAnimationFrame(() => {
          path.style.strokeDashoffset = '0';
        });
      };

      path.addEventListener('transitionend', (event) => {
        if (event.propertyName === 'stroke-dashoffset') finish();
      });

      observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          start();
          observer?.disconnect();
        },
        { rootMargin: '0px 0px 20% 0px' },
      );

      reducedMotion.addEventListener('change', () => {
        if (reducedMotion.matches) {
          observer?.disconnect();
          finish();
        }
      });

      observer.observe(line);
    };
  }
</script>

<style>
  .conversion-section {
    position: relative;
    isolation: isolate;
    overflow: visible;
    clip-path: inset(-100vmax 0);
    background: transparent;
    padding-block: clamp(4.5rem, 8vw, 7.5rem) clamp(4.5rem, 7vw, 6.5rem);
  }

  .conversion-section__line {
    position: absolute;
    z-index: 0;
    top: 3rem;
    left: 0;
    width: 100vw;
    height: max(17.65625rem, 41.475vw);
    overflow: clip;
    pointer-events: none;
  }

  .conversion-section__line :global(svg) {
    position: absolute;
    top: 0;
    left: 50%;
    display: block;
    width: max(46rem, 108vw);
    height: auto;
    overflow: visible;
    transform: translate(-50%, 2.375rem);
  }

  .conversion-section__line[data-drawing='true'] :global(path) {
    transition: stroke-dashoffset 1600ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .conversion-section__inner {
    position: relative;
    z-index: 1;
    width: min(calc(100% - 2rem), 77.5rem);
    min-height: 25rem;
    margin-inline: auto;
  }

  .conversion-section__copy {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    max-width: 32.1875rem;
    margin-inline: auto;
    text-align: center;
  }

  .conversion-section__title {
    display: inline-block;
    background: var(--text-primary);
    color: var(--surface-elevated);
    padding: 0.625rem clamp(1rem, 3vw, 1.625rem);
    font-family: 'Vetrino', Georgia, serif;
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: 400;
    line-height: 1;
  }

  .conversion-section__description {
    max-width: 32.1875rem;
    margin-top: 1.75rem;
    font-size: 1rem;
    line-height: 1.1;
  }

  .conversion-section__actions {
    display: grid;
    width: min(100%, 18.25rem);
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .conversion-section__desserts {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 2.5rem calc(50% - 50vw) 0;
    padding-inline: max(0.25rem, calc((100vw - 22rem) / 2));
    pointer-events: none;
  }

  .conversion-section__dessert {
    display: block;
    flex: 0 1 auto;
  }

  .conversion-section__dessert :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .conversion-section__dessert--left {
    width: min(56vw, 17rem);
  }

  .conversion-section__dessert--right {
    width: min(60vw, 18rem);
  }

  @media (min-width: 40rem) {
    .conversion-section__inner {
      min-height: 27rem;
    }

    .conversion-section__copy {
      padding-top: 0.5rem;
    }

    .conversion-section__desserts {
      position: absolute;
      inset: 2.75rem -2rem auto;
      display: block;
      margin: 0;
      padding: 0;
    }

    .conversion-section__dessert {
      position: absolute;
    }

    .conversion-section__dessert--left {
      top: 1.5rem;
      left: 0;
      width: min(31vw, 24.5rem);
    }

    .conversion-section__dessert--right {
      top: 3.75rem;
      right: 0;
      width: min(34vw, 28.7rem);
    }
  }

  @media (min-width: 75rem) {
    .conversion-section__line {
      top: 4.3125rem;
    }

    .conversion-section__line :global(svg) {
      left: 51.75%;
      transform: translate(calc(-50% - 5rem), 2.375rem);
    }

    .conversion-section__inner {
      min-height: 25rem;
    }

    .conversion-section__desserts {
      inset-inline: -3.125rem;
    }

    .conversion-section__dessert--left {
      top: 0.65rem;
    }

    .conversion-section__dessert--right {
      top: 2.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .conversion-section__line[data-drawing='true'] :global(path) {
      transition: none;
    }
  }
</style>
