---
import { Picture } from 'astro:assets';
import dessertLeft from '@/assets/conversion/dessert-left.png';
import dessertRight from '@/assets/conversion/dessert-right.png';
import selectionFlow from '@/assets/conversion/selection-flow.svg?raw';
import ActionLink from '@/components/ActionLink.astro';
import { getWhatsAppUrl, HOME_SECTION_IDS } from '@/lib/site';

const whatsappUrl = getWhatsAppUrl('selectionHelp');
---

<section
  id={HOME_SECTION_IDS.conversion}
  class="conversion-section"
  data-section-spacing-target
  data-motion-group
  aria-labelledby="conversion-title"
>
  <div class="conversion-section__line" aria-hidden="true" set:html={selectionFlow} />
  <div class="conversion-section__inner">
    <h2 id="conversion-title" class="conversion-section__title" data-section-title data-motion="heading">
      Не знаете что выбрать?
    </h2>

    <div class="conversion-section__desserts" aria-hidden="true">
      <div
        class="conversion-section__dessert conversion-section__dessert--left"
        data-selection-dessert="left"
      >
        <Picture
          src={dessertLeft}
          formats={['avif', 'webp']}
          widths={[240, 320, 392, 480, 640, 784]}
          sizes="(max-width: 39.999rem) 40vw, (max-width: 47.999rem) 27vw, (max-width: 74.999rem) 26vw, 31rem"
          alt=""
          loading="lazy"
        />
      </div>
      <div
        class="conversion-section__dessert conversion-section__dessert--right"
        data-selection-dessert="right"
      >
        <Picture
          src={dessertRight}
          formats={['avif', 'webp']}
          widths={[260, 360, 459, 560, 720, 918]}
          sizes="(max-width: 39.999rem) 44vw, (max-width: 74.999rem) 28vw, 459px"
          alt=""
          loading="lazy"
        />
      </div>
    </div>

    <div class="conversion-section__copy" data-motion-trigger>
      <p class="conversion-section__description" data-motion="copy">
        Напишите нам в WhatsApp. Подскажем, какие десерты есть в наличии и где их удобнее купить.
      </p>
      <div class="conversion-section__actions">
        <ActionLink
          variant="primary"
          href={whatsappUrl}
          fullWidth="mobile"
          size="selection"
          external
        >
          Написать в Whatsapp
        </ActionLink>
        <ActionLink
          variant="secondary"
          href={`#${HOME_SECTION_IDS.assortment}`}
          fullWidth="mobile"
          size="selection"
        >
          Посмотреть ассортимент
        </ActionLink>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { mountMotion } from '@/lib/motion-lifecycle';
  const cleanup = mountMotion(
    '.conversion-section',
    ({ element: selection, onceVisible }) => {
      onceVisible(() => {
        const desserts = selection.querySelectorAll('[data-selection-dessert]');
        gsap.fromTo(
          desserts,
          { y: innerWidth < 768 ? 12 : 24, opacity: 0, rotation: (i: number) => (i ? 3 : -3) },
          {
            y: 0,
            opacity: 1,
            rotation: 0,
            duration: 1,
            ease: 'back.out(1.1)',
            clearProps: 'transform,opacity',
          },
        );
        const button = selection.querySelector('.action-link');
        button?.dispatchEvent(new Event('action-emphasis'));
      });
    },
  );
  if (import.meta.hot) import.meta.hot.dispose(cleanup);

  document
    .querySelectorAll<HTMLAnchorElement>('.conversion-section a[href^="#"]')
    .forEach((link) => {
      link.addEventListener('click', (event) => {
        const href = link.getAttribute('href') ?? '';
        const target = document.getElementById(href.slice(1));
        const heading = target?.querySelector<HTMLElement>('h1, h2, h3');
        if (!target || !heading) return;
        event.preventDefault();
        history.pushState(null, '', href);
        target.style.scrollMarginTop = 'var(--header-offset)';
        target.scrollIntoView({
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          block: 'start',
        });
        heading.setAttribute('tabindex', '-1');
        heading.focus({ preventScroll: true });

        const alignTarget = () => {
          if (document.activeElement !== heading || location.hash !== href) return;
          const marginTop = Number.parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
          const delta = target.getBoundingClientRect().top - marginTop;
          if (Math.abs(delta) > 1) window.scrollBy({ top: delta, behavior: 'auto' });
        };
        let correctionTimer = window.setTimeout(alignTarget, 1200);
        window.addEventListener(
          'scrollend',
          () => {
            window.clearTimeout(correctionTimer);
            alignTarget();
          },
          { once: true },
        );
      });
    });
</script>

<style>
  .conversion-section {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    overflow-y: visible;
    background: transparent;
    padding-block: 3.625rem 3rem;
  }

  .conversion-section__line {
    position: absolute;
    inset: 3.625rem 0 auto;
    height: 7rem;
    pointer-events: none;
    z-index: 0;
  }

  .conversion-section__line :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .conversion-section__inner {
    position: relative;
    z-index: 1;
    width: min(calc(100% - 2rem), 77.5rem);
    margin-inline: auto;
    text-align: center;
  }

  .conversion-section__title {
    position: relative;
    z-index: 2;
    display: inline-block;
    margin: 0;
    background: var(--text-primary);
    color: var(--surface-elevated);
    padding: 0.333rem 0.867rem;
    font-family: 'Vetrino', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1;
    width: calc(100% - 1.5rem);
  }

  .conversion-section__copy {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    max-width: 32.1875rem;
    margin-inline: auto;
    margin-top: 1.425rem;
    text-align: center;
  }

  .conversion-section__description {
    max-width: 32.1875rem;
    margin-top: 0;
    font-size: 1rem;
    line-height: 1;
  }

  .conversion-section__actions {
    display: grid;
    width: 100%;
    gap: 0.875rem;
    margin-top: 1rem;
  }

  .conversion-section__desserts {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: end;
    justify-content: space-between;
    width: 100vw;
    min-height: 6.702rem;
    gap: 0.5rem;
    margin: -0.35rem calc(50% - 50vw) 0;
    padding-inline: max(0.25rem, calc((100vw - 21.8rem) / 2));
    pointer-events: none;
  }

  .conversion-section__dessert {
    display: block;
    flex: 0 1 auto;
    overflow: hidden;
    aspect-ratio: 392 / 269;
  }

  .conversion-section__dessert :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .conversion-section__dessert--left {
    width: min(40.15vw, 9.78125rem);
  }

  .conversion-section__dessert--right {
    display: block;
    width: min(44vw, 10.75rem);
    aspect-ratio: 459.15 / 276.36;
  }

  @media (min-width: 40rem) {
    .conversion-section__line { top: 6.25rem; height: 13rem; }
    .conversion-section {
      padding-block: 3.75rem 4.3125rem;
    }

    .conversion-section__title {
      padding: 0.333rem 0.867rem;
      font-size: 1.875rem;
      width: 64.86vw;
    }

    .conversion-section__copy {
      width: min(100%, 20.875rem);
      margin-top: 1rem;
    }

    .conversion-section__description {
      margin-top: 0;
      line-height: 1;
    }

    .conversion-section__actions {
      width: min(100%, 18.25rem);
      margin-inline: auto;
      margin-top: 1rem;
    }

    .conversion-section__desserts {
      position: absolute;
      inset: 4.05rem -0.75rem auto;
      width: auto;
      min-height: 0;
      display: block;
      margin: 0;
      padding: 0;
    }

    .conversion-section__dessert {
      position: absolute;
    }

    .conversion-section__dessert--left {
      top: 0;
      left: 1.5375rem;
      width: clamp(13.05rem, calc(25.25vw), 16.125rem);
    }

    .conversion-section__dessert--right {
      top: 0;
      right: 0.5rem;
      width: 28vw;
    }
  }

  @media (min-width: 62rem) {
    .conversion-section__line { top: 6.5rem; height: 22rem; }
    .conversion-section {
      padding-block: 8.6875rem 4.1875rem;
    }

    .conversion-section__title {
      padding: 0.444rem 1.155rem;
      font-size: 2.5rem;
      width: 64.86vw;
    }

    .conversion-section__copy {
      width: min(100%, 26.5rem);
      margin-top: 1rem;
    }

    .conversion-section__actions {
      margin-top: 1rem;
    }

    .conversion-section__desserts {
      inset: 3.6rem -1.25rem auto;
    }

    .conversion-section__dessert--left {
      left: 3.75rem;
      width: clamp(16.125rem, 25.25vw, 16.125rem);
    }

    .conversion-section__dessert--right {
      display: block;
      right: 1.85rem;
      width: clamp(19.45rem, 30.4vw, 28.7rem);
      aspect-ratio: 459.15 / 276.36;
    }
  }


  @media (min-width: 75rem) {
    .conversion-section__line { top: 105px; height: 553px; }
    .conversion-section {
      padding-block: 175px 11px;
    }

    .conversion-section__title {
      padding: 10px 26px;
      font-size: 64px;
      width: min(64.86vw, 934px);
    }

    .conversion-section__copy {
      width: 515px;
      max-width: 100%;
      margin-top: 20px;
    }

    .conversion-section__description {
      font-size: 16px;
      line-height: 16px;
    }

    .conversion-section__actions {
      width: 292px;
      gap: 20px;
      margin-top: 28px;
      margin-left: 96px;
      margin-right: 0;
      justify-self: start;
    }

    .conversion-section__desserts {
      inset: 10px -3.125rem auto;
    }

    .conversion-section__dessert--left {
      left: 1.75rem;
      width: min(27.22vw, 392px);
    }

    .conversion-section__dessert--right {
      right: 0.5625rem;
      width: min(31.9vw, 459.15px);
    }
  }
</style>
