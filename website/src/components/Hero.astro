---
import { Picture } from 'astro:assets';
import heroCake from '@/assets/hero/hero-cake-transparent.png';
import ActionLink from '@/components/ActionLink.astro';
import { HOME_SECTION_IDS } from '@/lib/site';
import heroPreparationScript from '@/scripts/hero-preparation.inline.js?raw';

---

<section id={HOME_SECTION_IDS.hero} class="hero">
  <div class="hero__media" data-hero-media aria-hidden="true">
    <div class="hero__cake">
      <Picture
        src={heroCake}
        formats={['avif', 'webp']}
        widths={[320, 480, 640, 768, 872]}
        sizes="(max-width: 639px) min(75vw, 19rem), (max-width: 899px) min(53vw, 28rem), (max-width: 1199px) min(47vw, 34rem), min(44vw, 43rem)"
        alt=""
        priority
      />
    </div>
  </div>

  <div class="hero__inner">
    <div class="hero__copy">
      <h1 class="hero__title">
        Тот самый медовик из&nbsp;детства по&nbsp;семейному рецепту{' '}
        <span class="hero__desktop-break"
          >от&nbsp;<span class="hero__brand-z">Z</span>OTOV bakery</span
        >
      </h1>

      <p class="hero__intro">
        Кондитерская домашних традиций. Попробуйте наш легендарный медовик, воздушные «Дамские
        пальчики», тающий торт «Нежность» и другие свежие десерты на каждый день и для особого
        повода.
      </p>

      <div class="hero__actions">
        <ActionLink variant="primary" href={`#${HOME_SECTION_IDS.whereToBuy}`}>
          Где купить
        </ActionLink>
        <ActionLink variant="secondary" href={`#${HOME_SECTION_IDS.assortment}`}>
          Посмотреть ассортимент
        </ActionLink>
      </div>
    </div>
  </div>

  <div class="hero__scallop" aria-hidden="true"></div>
</section>

<script is:inline set:html={heroPreparationScript}></script>

<script>
  import { gsap } from 'gsap';
  // Copy is visible from the first paint, including when fonts or scripts fail.
  const media = gsap.matchMedia();
  let played = false;
  media.add('(min-width: 48rem) and (prefers-reduced-motion: no-preference)', () => {
    if (played || location.hash || scrollY > 20) return;
    const copy = document.querySelector('.hero__copy');
    if (!copy) return;
    played = true;
    const entrance = gsap.fromTo(copy, { y: 8 }, {
      y: 0, duration: 0.4, ease: 'power2.out', clearProps: 'transform',
    });
    const events = new AbortController();
    const finish = () => entrance.progress(1).pause();
    copy?.addEventListener('focusin', finish, { signal: events.signal });
    copy?.addEventListener('pointerdown', finish, { signal: events.signal });
    window.addEventListener('scroll', finish, { passive: true, signal: events.signal });
    return () => events.abort();
  });
  if (import.meta.hot) import.meta.hot.dispose(() => media.revert());
</script>

<style>
  .hero {
    position: relative;
    z-index: 4;
    min-height: 35.75rem;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(ellipse 76% 72% at 18% 92%, rgb(204 194 184 / 42%) 0%, transparent 72%),
      radial-gradient(ellipse 65% 68% at 83% 58%, rgb(255 252 248 / 48%) 0%, transparent 74%),
      linear-gradient(135deg, #e4ddd5 0%, #eee8e2 54%, #e5ded7 100%);
  }

  .hero__media {
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
  }

  .hero__cake {
    position: absolute;
    bottom: 1.5625rem;
    left: 50%;
    width: clamp(16.5rem, 75vw, 19rem);
    transform: translateX(-50%);
    opacity: 1;
  }

  .hero__cake::before {
    position: absolute;
    z-index: -1;
    right: 3%;
    bottom: 4%;
    left: 4%;
    height: 14%;
    border-radius: 50%;
    background: radial-gradient(
      ellipse,
      rgb(75 55 48 / 34%) 0%,
      rgb(75 55 48 / 16%) 42%,
      transparent 74%
    );
    content: '';
    filter: blur(0.75rem);
    transform: scaleX(0.93);
  }

  .hero__cake picture,
  .hero__cake img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero__cake img {
    filter: drop-shadow(0 0.5rem 0.625rem rgb(75 55 48 / 11%));
  }

  .hero__media[data-error='true'] .hero__cake {
    opacity: 0;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    width: min(calc(100% - 2rem), 77.5rem);
    min-height: 35.75rem;
    flex-direction: column;
    margin-inline: auto;
    padding-top: 0;
    padding-bottom: 14.6875rem;
  }

  .hero__copy {
    margin-top: 1.1875rem;
  }

  .hero__title {
    max-width: 23.1875rem;
    font-family: 'Vetrino', 'Vetrino Fallback', Georgia, serif;
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: 0.01em;
    text-wrap: pretty;
  }

  .hero__desktop-break {
    display: inline;
  }

  .hero__brand-z {
    font-family: 'Bergamasco', 'Vetrino', 'Vetrino Fallback', Georgia, serif;
  }

  .hero__intro {
    max-width: 20.6875rem;
    margin-top: 0.625rem;
    font-family: 'Nunito', 'Nunito Fallback', Arial, sans-serif;
    font-size: 1rem;
    line-height: 1;
  }

  .hero__actions {
    display: grid;
    width: fit-content;
    gap: 0.625rem;
    margin-top: 1.25rem;
  }

  .hero__scallop {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: -0.0625rem;
    left: 0;
    height: 1.15625rem;
    background: var(--page);
    -webkit-mask: url('/hero/scallop-tile.svg') center top / 2.0625rem 2.3125rem repeat-x;
    mask: url('/hero/scallop-tile.svg') center top / 2.0625rem 2.3125rem repeat-x;
    pointer-events: none;
  }

  @media (max-width: 74.999rem) {
    .hero {
      padding-top: var(--header-expanded-height);
    }
  }

  @media (max-width: 39.999rem) {
    .hero__cake::before {
      bottom: 5%;
      height: 15%;
    }
  }

  @media (min-width: 40rem) and (max-width: 56.249rem) {
    .hero,
    .hero__inner {
      min-height: 28.5rem;
    }

    .hero__cake {
      right: -0.5rem;
      bottom: 1.25rem;
      left: auto;
      width: clamp(23.5rem, 53vw, 28rem);
      transform: none;
    }

    .hero__inner {
      width: calc(100% - 5rem);
      padding-bottom: 0;
    }

    .hero__copy {
      width: 100%;
      max-width: 37.625rem;
      margin-top: 1.875rem;
    }

    .hero__title {
      max-width: 37.1875rem;
      font-size: 2.25rem;
      line-height: 1.05;
      text-wrap: balance;
    }

    .hero__desktop-break {
      display: block;
    }

    .hero__intro {
      max-width: 24.75rem;
      margin-top: 0.9375rem;
    }

    .hero__actions {
      gap: 0.5625rem;
      margin-top: 1.25rem;
    }
  }

  @media (min-width: 56.25rem) and (max-width: 74.999rem) {
    .hero,
    .hero__inner {
      min-height: 28.8125rem;
    }

    .hero__cake {
      right: -0.75rem;
      bottom: 1.125rem;
      left: auto;
      width: clamp(29rem, 47vw, 34rem);
      transform: none;
    }

    .hero__inner {
      width: calc(100% - 8.75rem);
      max-width: none;
      padding-bottom: 0;
    }

    .hero__copy {
      width: 100%;
      max-width: 50.4375rem;
      margin-top: 5rem;
    }

    .hero__title {
      max-width: 50.4375rem;
      font-size: 3rem;
      line-height: 1;
      text-wrap: balance;
    }

    .hero__desktop-break {
      display: block;
    }

    .hero__intro {
      max-width: 32.5625rem;
      margin-top: 0.9375rem;
    }

    .hero__actions {
      display: flex;
      gap: 0.5625rem;
      margin-top: 2.5rem;
    }

    .hero__scallop {
      height: 1.44625rem;
      -webkit-mask-size: 2.5625rem 2.8925rem;
      mask-size: 2.5625rem 2.8925rem;
    }
  }

  @media (min-width: 75rem) {
    .hero {
      min-height: calc(30.6875rem + var(--header-expanded-height));
      background:
        radial-gradient(ellipse 66% 74% at 25% 94%, rgb(205 195 185 / 41%) 0%, transparent 74%),
        radial-gradient(ellipse 62% 73% at 84% 58%, rgb(255 253 249 / 51%) 0%, transparent 76%),
        linear-gradient(135deg, #e1dad2 0%, #eee8e2 53%, #e4ddd6 100%);
    }

    .hero__inner {
      display: block;
      min-height: calc(30.6875rem + var(--header-expanded-height));
      padding-bottom: 0;
    }

    .hero__cake {
      right: max(1.5rem, calc((100% - 77.5rem) / 2 - 3.75rem));
      bottom: 1.5rem;
      left: auto;
      width: clamp(37rem, calc(var(--layout-viewport) * 0.44), 43rem);
      transform: translateX(clamp(6.25rem, calc(var(--layout-viewport) * 0.38 - 30.4rem), 20rem));
    }

    .hero__cake::before {
      right: 2%;
      bottom: 3%;
      left: 3%;
      height: 13%;
      filter: blur(1rem);
    }

    .hero__copy {
      position: absolute;
      top: calc(1.6875rem + var(--header-expanded-height));
      left: 0;
      margin-top: 0;
    }

    .hero__title {
      width: 57.8125rem;
      max-width: none;
      font-size: 3.4375rem;
      line-height: 1;
      text-wrap: initial;
    }

    .hero__desktop-break {
      display: block;
    }

    .hero__intro {
      width: 42.8125rem;
      max-width: none;
      margin-top: 1.0625rem;
      line-height: 1;
    }

    .hero__actions {
      display: flex;
      width: fit-content;
      gap: 0.5625rem;
      margin-top: 1.5rem;
    }

    .hero__scallop {
      height: 2.03125rem;
      -webkit-mask-size: 3.6rem 4.0625rem;
      mask-size: 3.6rem 4.0625rem;
    }
  }
</style>
