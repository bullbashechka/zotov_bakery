        d="M528 76.6268C517.404 105.979 483.595 164.682 433.13 164.682C370.049 164.682 393.891 3.5 340.744 3.5C266.736 3.5 286.107 552.457 194.715 552.457C103.322 552.457 110.276 372.814 49.6782 372.814C-10.9191 372.814 19.3795 668.5 -74 668.5"
