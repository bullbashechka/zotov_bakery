---
import { HOME_SECTION_IDS } from '@/lib/site';

const advantages = [
  {
    title: 'Семейные рецепты',
    description: 'Сохраняем семейные рецепты и знакомый вкус любимых десертов.',
    image: '/advantages/family-recipes.svg',
  },
  {
    title: 'Печём торты и десерты с 1992 года',
    description: 'Сохраняем проверенные рецептуры и совершенствуем производство более 30 лет.',
    image: '/advantages/baking-since-1992.svg',
  },
  {
    title: 'Собственное производство',
    description: 'Контролируем каждый этап – от выбора ингредиентов до упаковки готового десерта.',
    image: '/advantages/own-production.svg',
  },
  {
    title: 'Натуральные ингредиенты',
    description: 'Используем натуральный мёд, сливочное масло и другие проверенные ингредиенты.',
    image: '/advantages/natural-ingredients.svg',
  },
] as const;
---

<section id={HOME_SECTION_IDS.advantages} class="advantages" aria-labelledby="advantages-title">
  <div class="advantages__desktop-line" aria-hidden="true">
    <picture>
      <source media="(max-width: 55.999rem)" srcset="/advantages/line-tablet.svg" />
      <source media="(max-width: 79.999rem)" srcset="/advantages/line-laptop.svg" />
      <img src="/advantages/line.svg" width="1440" height="366" alt="" />
    </picture>
  </div>

  <div class="advantages__mobile-lines" aria-hidden="true">
    <img class="advantages__mobile-line advantages__mobile-line--top" src="/advantages/mobile-line-top.svg" width="390" height="119" alt="" />
    <img class="advantages__mobile-line advantages__mobile-line--middle" src="/advantages/mobile-line-middle.svg" width="390" height="747" alt="" />
    <img class="advantages__mobile-line advantages__mobile-line--bottom" src="/advantages/mobile-line-bottom.svg" width="390" height="669" alt="" />
  </div>

  <div class="advantages__content">
    <h2 id="advantages-title" class="advantages__title">
      <span>Секрет вкуса,</span>
      <span>знакомого с детства</span>
    </h2>

    <advantages-carousel aria-label="Преимущества ZOTOV bakery">
      <div class="advantages__track" data-advantages-track aria-label="Преимущества ZOTOV bakery">
        {advantages.map((advantage, index) => (
          <article class="advantages__card" data-advantages-card aria-label={`Преимущество ${index + 1} из ${advantages.length}`}>
            <h3 class="advantages__card-title">{advantage.title}</h3>
            <div class="advantages__art" aria-hidden="true">
              <img src={advantage.image} width="213" height="171" alt="" loading="lazy" />
            </div>
            <p class="advantages__description">{advantage.description}</p>
          </article>
        ))}
      </div>

      <p class="sr-only" data-advantages-status role="status" aria-live="polite">Карточка 1 из 4</p>
    </advantages-carousel>
  </div>
</section>

<script>
  class AdvantagesCarousel extends HTMLElement {
    private track: HTMLElement | null = null;
    private cards: HTMLElement[] = [];
    private status: HTMLElement | null = null;
    private activeIndex = 0;
    private announcedIndex = 0;
    private scrollFrame = 0;
    private announceTimer = 0;
    private resizeObserver: ResizeObserver | null = null;
    private scrollQuery = window.matchMedia('(min-width: 40rem) and (max-width: 79.999rem)');

    connectedCallback() {
      this.track = this.querySelector<HTMLElement>('[data-advantages-track]');
      this.cards = Array.from(this.querySelectorAll<HTMLElement>('[data-advantages-card]'));
      this.status = this.querySelector<HTMLElement>('[data-advantages-status]');

      if (!this.track || this.cards.length === 0) return;

      this.track.addEventListener('scroll', this.handleScroll, { passive: true });
      this.track.addEventListener('keydown', this.handleKeydown);
      this.scrollQuery.addEventListener('change', this.handleBreakpointChange);
      this.resizeObserver = new ResizeObserver(this.updateFromScroll);
      this.resizeObserver.observe(this.track);
      this.updateInteractivity();
    }

    disconnectedCallback() {
      this.track?.removeEventListener('scroll', this.handleScroll);
      this.track?.removeEventListener('keydown', this.handleKeydown);
      this.scrollQuery.removeEventListener('change', this.handleBreakpointChange);
      this.resizeObserver?.disconnect();
      window.cancelAnimationFrame(this.scrollFrame);
      window.clearTimeout(this.announceTimer);
    }

    private isScrollable = () => this.scrollQuery.matches;

    private handleScroll = () => {
      if (!this.isScrollable()) return;

      window.cancelAnimationFrame(this.scrollFrame);
      this.scrollFrame = window.requestAnimationFrame(() => this.updateFromScroll());
      window.clearTimeout(this.announceTimer);
      this.announceTimer = window.setTimeout(this.announceActive, 140);
    };

    private handleKeydown = (event: KeyboardEvent) => {
      if (!this.isScrollable()) return;
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;

      event.preventDefault();
      this.scrollToIndex(this.activeIndex + (event.key === 'ArrowRight' ? 1 : -1));
    };

    private handleBreakpointChange = () => {
      this.activeIndex = 0;
      this.track?.scrollTo({ left: 0, behavior: 'auto' });
      this.updateInteractivity();
    };

    private updateFromScroll = () => {
      if (!this.track || !this.isScrollable()) return;

      let closestIndex = 0;
      let closestDistance = Number.POSITIVE_INFINITY;
      const maxScrollLeft = Math.max(0, this.track.scrollWidth - this.track.clientWidth);

      if (this.track.scrollLeft <= 1) {
        closestIndex = 0;
      } else if (this.track.scrollLeft >= maxScrollLeft - 1) {
        closestIndex = this.cards.length - 1;
      } else {
        const scrollPadding = Number.parseFloat(getComputedStyle(this.track).scrollPaddingLeft) || 0;
        const snapPosition = this.track.scrollLeft + scrollPadding;

        this.cards.forEach((card, index) => {
          const distance = Math.abs(card.offsetLeft - snapPosition);

          if (distance < closestDistance) {
            closestDistance = distance;
            closestIndex = index;
          }
        });
      }

      if (closestIndex !== this.activeIndex) {
        this.activeIndex = closestIndex;
      }
    };

    private scrollToIndex(index: number) {
      if (!this.track || !this.isScrollable()) return;

      const nextIndex = Math.max(0, Math.min(index, this.cards.length - 1));
      const card = this.cards[nextIndex];
      const scrollPadding = Number.parseFloat(getComputedStyle(this.track).scrollPaddingLeft) || 0;
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      this.activeIndex = nextIndex;
      this.track.scrollTo({
        left: card.offsetLeft - scrollPadding,
        behavior: prefersReducedMotion ? 'auto' : 'smooth',
      });
      window.clearTimeout(this.announceTimer);
      this.announceTimer = window.setTimeout(this.announceActive, prefersReducedMotion ? 0 : 180);
    }

    private updateInteractivity = () => {
      if (!this.track) return;

      if (this.isScrollable()) {
        this.track.tabIndex = 0;
        this.track.setAttribute('aria-label', 'Прокручиваемая лента преимуществ');
      } else {
        this.track.removeAttribute('tabindex');
        this.track.setAttribute('aria-label', 'Преимущества ZOTOV bakery');
      }
    };

    private announceActive = () => {
      if (this.status && this.announcedIndex !== this.activeIndex) {
        this.status.textContent = `Карточка ${this.activeIndex + 1} из ${this.cards.length}`;
        this.announcedIndex = this.activeIndex;
      }
    };
  }

  if (!customElements.get('advantages-carousel')) {
    customElements.define('advantages-carousel', AdvantagesCarousel);
  }
</script>

<style>
  .advantages {
    position: relative;
    z-index: 5;
    min-height: max(102.1875rem, 419.2308vw);
    overflow: visible;
    background: var(--page);
  }

  .advantages__desktop-line {
    display: none;
  }

  .advantages__mobile-lines {
    position: absolute;
    z-index: 1;
    top: -3.9375rem;
    left: 0;
    width: max(100%, 24.375rem);
    height: auto;
    aspect-ratio: 390 / 1694;
    pointer-events: none;
  }

  .advantages__mobile-line {
    position: absolute;
    left: 0;
    display: block;
    width: 100%;
    max-width: none;
  }

  .advantages__mobile-line--top {
    top: 0.4132%;
  }

  .advantages__mobile-line--middle {
    top: 11.6883%;
  }

  .advantages__mobile-line--bottom {
    top: 60.7438%;
    left: max(0px, calc(100vw - 24.375rem));
  }

  .advantages__content {
    position: relative;
    z-index: 2;
    width: 100%;
    margin-inline: auto;
    padding-top: 0.125rem;
  }

  .advantages__title {
    display: grid;
    width: 18.5625rem;
    justify-items: start;
    margin-left: 2.3125rem;
    color: var(--surface-elevated);
    font-family: 'Vetrino', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1;
    text-align: center;
  }

  .advantages__title span {
    min-height: 2.25rem;
    background: var(--text-primary);
    padding: 0.375rem 0.875rem;
    white-space: nowrap;
  }

  .advantages__title span:first-child {
    margin-left: 0.6875rem;
  }

  advantages-carousel {
    display: block;
    margin-top: 1.0625rem;
  }

  .advantages__track {
    display: grid;
    gap: 1.25rem;
    width: 100%;
    overflow: visible;
  }

  .advantages__card {
    display: grid;
    width: 17.25rem;
    min-height: 21.9375rem;
    grid-template-rows: minmax(2.5rem, auto) minmax(9.6875rem, 1fr) auto;
    border-radius: 0.75rem;
    background: var(--surface);
    padding: 1.25rem;
  }

  .advantages__card:nth-child(odd) {
    margin-left: 1rem;
  }

  .advantages__card:nth-child(even) {
    margin-right: 1rem;
    margin-left: auto;
  }

  .advantages__card:nth-child(2) {
    height: 22rem;
    min-height: 22rem;
  }

  .advantages__card-title {
    max-width: 14.75rem;
    font-family: 'Vetrino', Georgia, serif;
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1;
  }

  .advantages__art {
    display: grid;
    min-height: 9.6875rem;
    align-items: center;
    justify-items: center;
  }

  .advantages__art img {
    display: block;
    width: min(100%, 12.875rem);
    max-height: 10rem;
    object-fit: contain;
  }

  .advantages__description {
    color: var(--text-primary);
    font-size: 1rem;
    line-height: 1;
  }

  @media (min-width: 24.375rem) and (max-width: 39.999rem) {
    .advantages__mobile-lines {
      top: -16.1538vw;
    }
  }

  @media (min-width: 40rem) {
    .advantages {
      min-height: 27.375rem;
    }

    .advantages__mobile-lines {
      display: none;
    }

    .advantages__desktop-line {
      position: absolute;
      z-index: 1;
      top: -5.625rem;
      left: 0;
      display: block;
      width: 100%;
      height: 12.9375rem;
      overflow: clip;
      pointer-events: none;
    }

    .advantages__desktop-line picture {
      display: block;
      width: 100%;
      height: 100%;
      overflow: clip;
    }

    .advantages__desktop-line img {
      display: block;
      width: max(48rem, 100%);
      height: auto;
      max-width: none;
      margin-left: 50%;
      transform: translateX(-50%);
    }

    .advantages__content {
      width: 100%;
      padding-top: 1.3125rem;
    }

    .advantages__title {
      display: flex;
      width: 38.125rem;
      min-height: 3.125rem;
      align-items: center;
      justify-content: center;
      gap: 0.25em;
      margin-inline: auto;
      background: var(--text-primary);
      padding: 0.4375rem 1.5rem;
      font-size: 1.875rem;
      white-space: nowrap;
    }

    .advantages__title span {
      min-height: 0;
      background: transparent;
      padding: 0;
    }

    .advantages__title span:first-child {
      margin-left: 0;
    }

    advantages-carousel {
      margin-top: 0.875rem;
    }

    .advantages__track {
      display: flex;
      gap: 1.25rem;
      width: 100%;
      margin-left: 0;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      padding-inline: 2.5rem;
      scroll-padding-inline: 2.5rem;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .advantages__track::-webkit-scrollbar {
      display: none;
    }

    .advantages__card:nth-child(n) {
      flex: 0 0 17.25rem;
      width: 17.25rem;
      min-height: 22rem;
      scroll-snap-align: start;
      margin: 0;
    }
  }

  @media (min-width: 56.25rem) {
    .advantages {
      min-height: 34.25rem;
    }

    .advantages__desktop-line {
      top: -5.3125rem;
      height: 16.875rem;
    }

    .advantages__desktop-line img {
      width: max(64rem, 100%);
    }

    .advantages__content {
      padding-top: 2.875rem;
    }

    .advantages__title {
      width: 51.125rem;
      min-height: 3.75rem;
      font-size: 2.5rem;
    }

    advantages-carousel {
      margin-top: 1.25rem;
    }

    .advantages__track {
      width: 100%;
      margin-left: 0;
      padding-inline: 4.375rem;
      scroll-padding-inline: 4.375rem;
    }

    .advantages__card:nth-child(n) {
      flex-basis: 18.4375rem;
      width: 18.4375rem;
      height: 25rem;
      min-height: 25rem;
      grid-template-rows: minmax(3.75rem, auto) minmax(10.75rem, 1fr) auto;
      padding: 1.875rem;
    }

    .advantages__card-title {
      max-width: none;
      font-size: 1.625rem;
    }

    .advantages__art {
      min-height: 10.75rem;
      padding-block: 0.625rem;
    }

    .advantages__art img {
      width: min(100%, 13.3125rem);
      max-height: 10.75rem;
    }

    .advantages__description {
      color: var(--text-primary);
      line-height: 1;
    }
  }

  @media (min-width: 80rem) {
    .advantages {
      z-index: 5;
      min-height: 37.875rem;
      margin-top: -2.75rem;
      overflow: visible;
      background: transparent;
    }

    .advantages__desktop-line {
      top: -5.5625rem;
      left: 0;
      width: 100%;
      height: 22.875rem;
      overflow: clip;
    }

    .advantages__desktop-line img {
      width: max(90rem, 100%);
    }

    .advantages__content {
      width: min(calc(100% - 2.5rem), 77.5rem);
      margin-inline: auto;
      padding-top: 6.75rem;
    }

    .advantages__title {
      width: 60.875rem;
      min-height: 4.25rem;
      padding: 0.5rem 2rem;
      font-size: 3rem;
    }

    advantages-carousel {
      margin-top: 1.875rem;
    }

    .advantages__track {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
      width: 100%;
      margin-left: 0;
      overflow: visible;
      padding-inline: 0;
      scroll-padding-inline: 0;
      scroll-snap-type: none;
    }

    .advantages__card:nth-child(n) {
      width: auto;
      min-width: 0;
      height: 25rem;
      min-height: 25rem;
      margin: 0;
      padding: 1.875rem;
    }

    .advantages__card-title {
      font-size: 1.875rem;
    }
  }
</style>
