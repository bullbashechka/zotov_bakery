---
import { HOME_NAV_LINKS, POLICY_LINKS } from '@/lib/site';
interface Props {
  variant: 'primary' | 'legal';
}
const { variant } = Astro.props;
const links = variant === 'primary' ? HOME_NAV_LINKS : POLICY_LINKS;
---

<nav
  class="footer-navigation"
  data-variant={variant}
  aria-label={variant === 'primary' ? 'Навигация в подвале' : 'Юридическая информация'}
>
  {links.map((link) => <a href={link.href}>{link.label}</a>)}
</nav>

<style>
  .footer-navigation[data-variant='primary'],
  .footer-navigation[data-variant='legal'] {
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    justify-content: center;
    column-gap: 1.5rem;
    row-gap: 0.25rem;
  }

  .footer-navigation[data-variant='primary'] a,
  .footer-navigation[data-variant='legal'] a {
    display: inline-flex;
    min-height: 1.25rem;
    align-items: center;
    border-radius: 0.25rem;
    color: inherit;
    font-size: 1rem;
    line-height: 1;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 180ms ease;
  }

  .footer-navigation[data-variant='primary'] a:is(:hover, :focus-visible),
  .footer-navigation[data-variant='legal'] a:is(:hover, :focus-visible) {
    text-decoration-color: currentColor;
  }

  @media (min-width: 40rem) {
    .footer-navigation[data-variant='primary'],
    .footer-navigation[data-variant='legal'] {
      column-gap: 1.25rem;
    }

    .footer-navigation[data-variant='primary'] {
      column-gap: 30px;
    }

    .footer-navigation[data-variant='legal'] {
      column-gap: 2rem;
    }
  }

  @media (max-width: 39.999rem) {
    .footer-navigation[data-variant='primary'],
    .footer-navigation[data-variant='legal'] {
      row-gap: 10px;
    }

    .footer-navigation[data-variant='primary'] a,
    .footer-navigation[data-variant='legal'] a {
      min-height: 16px;
      line-height: 16px;
    }
  }

  @media (min-width: 75rem) {
    .footer-navigation[data-variant='primary'] a,
    .footer-navigation[data-variant='legal'] a {
      min-height: 1.25rem;
      font-size: 16px;
    }

    .footer-navigation[data-variant='primary'],
    .footer-navigation[data-variant='legal'] {
      justify-content: flex-start;
      padding-left: 52px;
    }
  }
</style>
