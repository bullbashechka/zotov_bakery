---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PrivacyPolicy from '@/components/PrivacyPolicy.astro';
import { getCanonicalUrl } from '@/lib/site-origin.mjs';

const canonicalUrl = getCanonicalUrl(import.meta.env.PUBLIC_WEBSITE_URL, Astro.url.pathname);
---

<BaseLayout
  title="Конфиденциальность — ZOTOV bakery"
  description="Как ZOTOV bakery использует технические данные, cookie и Яндекс Метрику на сайте."
  {canonicalUrl}
>
  <PrivacyPolicy />
</BaseLayout>
