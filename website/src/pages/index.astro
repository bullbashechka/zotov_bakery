---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Assortment from '@/components/Assortment.astro';
import BrandHistory from '@/components/BrandHistory.astro';
import ConversionSection from '@/components/ConversionSection.astro';
import Faq from '@/components/Faq.astro';
import HeroAdvantagesFlow from '@/components/HeroAdvantagesFlow.astro';
import HoneyCake from '@/components/HoneyCake.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import WhereToBuy from '@/components/WhereToBuy.astro';

const title = 'ZOTOV bakery — десерты с характером';
const description = 'ZOTOV bakery — десерты, которые хочется разделить с близкими.';
const publicWebsiteUrl = import.meta.env.PUBLIC_WEBSITE_URL;
const canonicalUrl = publicWebsiteUrl
  ? new URL(Astro.url.pathname, publicWebsiteUrl).toString()
  : undefined;

---

<BaseLayout {title} {description} {canonicalUrl}>
  <SiteHeader slot="header" />

  <HeroAdvantagesFlow />

  <HoneyCake />
  <Assortment />
  <WhereToBuy />
  <BrandHistory />
  <Faq />
  <ConversionSection />

  <SiteFooter slot="footer" />
</BaseLayout>

<script>
  import { initPageMotion } from '@/lib/motion';

  const cleanup = initPageMotion(document);
  if (import.meta.hot)
    import.meta.hot.dispose(() => {
      cleanup();
    });
</script>
