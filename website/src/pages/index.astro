---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Advantages from '@/components/Advantages.astro';
import Assortment from '@/components/Assortment.astro';
import ConversionSection from '@/components/ConversionSection.astro';
import Faq from '@/components/Faq.astro';
import Hero from '@/components/Hero.astro';
import HeroAdvantagesFlow from '@/components/HeroAdvantagesFlow.astro';
import HoneyCake from '@/components/HoneyCake.astro';
import PlaceholderSection from '@/components/PlaceholderSection.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import WhereToBuy from '@/components/WhereToBuy.astro';
import { HOME_SECTION_IDS } from '@/lib/site';
import '@/styles/global.css';

const title = 'ZOTOV bakery — десерты с характером';
const description = 'ZOTOV bakery — десерты, которые хочется разделить с близкими.';
const publicWebsiteUrl = import.meta.env.PUBLIC_WEBSITE_URL;
const canonicalUrl = publicWebsiteUrl
  ? new URL(Astro.url.pathname, publicWebsiteUrl).toString()
  : undefined;

const placeholderSections = {
  history: { id: HOME_SECTION_IDS.history, title: 'Наша история' },
};
---

<BaseLayout {title} {description} {canonicalUrl}>
  <SiteHeader slot="header" />

  <HeroAdvantagesFlow>
    <Hero />
    <Advantages />
  </HeroAdvantagesFlow>

  <HoneyCake />
  <Assortment />
  <WhereToBuy />
  <PlaceholderSection id={placeholderSections.history.id} title={placeholderSections.history.title} />
  <Faq />
  <ConversionSection />

  <SiteFooter slot="footer" />
</BaseLayout>

<script>
  import { initPageMotion } from '@/lib/motion';
  import { initHeroMotion } from '@/lib/hero-motion';
  import { initExpressiveMotion } from '@/lib/expressive-motion';

  const cleanupHero = initHeroMotion(document);
  const cleanup = initPageMotion(document);
  const cleanupExpressive = initExpressiveMotion(document);
  if (import.meta.hot) import.meta.hot.dispose(() => {
    cleanupHero();
    cleanup();
    cleanupExpressive();
  });
</script>
