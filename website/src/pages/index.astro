---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Assortment from '@/components/Assortment.astro';
import BrandHistory from '@/components/BrandHistory.astro';
import ConversionSection from '@/components/ConversionSection.astro';
import Faq from '@/components/Faq.astro';
import HeroAdvantagesFlow from '@/components/HeroAdvantagesFlow.astro';
import HoneyCake from '@/components/HoneyCake.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import WhereToBuy from '@/components/WhereToBuy.astro';
import { getCanonicalUrl, validateSearchIndexing } from '@/lib/site-origin.mjs';
import { CONTACTS, SITE_DESCRIPTION, SITE_NAME, SITE_TITLE } from '@/lib/site';

const title = SITE_TITLE;
const description = SITE_DESCRIPTION;
const production = import.meta.env.PROD;
const allowIndexing = validateSearchIndexing(import.meta.env.PUBLIC_ALLOW_INDEXING, { required: production });
const canonicalUrl = getCanonicalUrl(import.meta.env.PUBLIC_WEBSITE_URL, Astro.url.pathname, { required: production });
const socialImageUrl = canonicalUrl ? new URL('/social-preview.png', canonicalUrl).toString() : undefined;
const websiteOrigin = canonicalUrl ? new URL(canonicalUrl).origin : undefined;
const structuredData = websiteOrigin
  ? {
      '@context': 'https://schema.org',
      '@type': ['Bakery', 'LocalBusiness'],
      name: SITE_NAME,
      url: websiteOrigin,
      image: socialImageUrl,
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'ул. Лермонтова, 63',
        addressLocality: 'Петропавловск',
        addressCountry: 'KZ',
      },
      telephone: [CONTACTS.bakery.display, CONTACTS.mobile.display],
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
          opens: '09:00',
          closes: '22:00',
        },
      ],
      sameAs: [CONTACTS.instagramUrl],
    }
  : undefined;

---

<BaseLayout
  {title}
  {description}
  {canonicalUrl}
  robots={allowIndexing ? undefined : 'noindex,follow'}
  {socialImageUrl}
  {structuredData}
>
  <SiteHeader slot="header" />

  <HeroAdvantagesFlow />

  <HoneyCake />
  <Assortment />
  <WhereToBuy />
  <BrandHistory />
  <Faq />
  <ConversionSection />

  <SiteFooter slot="footer" />
</BaseLayout>

<script>
  import { initPageMotion } from '@/lib/motion';
  import { initSectionSpacing } from '@/lib/section-spacing';
  import { initSmoothScroll } from '@/lib/smooth-scroll';

  const cleanupSmoothScroll = initSmoothScroll(document);
  const cleanup = initPageMotion(document);
  const cleanupSectionSpacing = initSectionSpacing(document);
  if (import.meta.hot)
    import.meta.hot.dispose(() => {
      cleanupSmoothScroll();
      cleanup();
      cleanupSectionSpacing();
    });
</script>
