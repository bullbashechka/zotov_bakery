---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Advantages from '@/components/Advantages.astro';
import ContactSection from '@/components/ContactSection.astro';
import Faq from '@/components/Faq.astro';
import Hero from '@/components/Hero.astro';
import HeroAdvantagesFlow from '@/components/HeroAdvantagesFlow.astro';
import PlaceholderSection from '@/components/PlaceholderSection.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { HOME_SECTION_IDS } from '@/lib/site';
import '@/styles/global.css';

const title = 'ZOTOV bakery — десерты с характером';
const description = 'ZOTOV bakery — десерты, которые хочется разделить с близкими.';
const publicWebsiteUrl = import.meta.env.PUBLIC_WEBSITE_URL;
const canonicalUrl = publicWebsiteUrl
  ? new URL(Astro.url.pathname, publicWebsiteUrl).toString()
  : undefined;

const pageSections = [
  { id: HOME_SECTION_IDS.honeyCake, title: 'Медовик' },
  { id: HOME_SECTION_IDS.assortment, title: 'Ассортимент' },
  { id: HOME_SECTION_IDS.whereToBuy, title: 'Где купить' },
  { id: HOME_SECTION_IDS.history, title: 'Наша история' },
  { id: HOME_SECTION_IDS.faq, title: 'Вопросы и ответы' },
  { id: HOME_SECTION_IDS.conversion, title: 'Выберите свой десерт' },
];
---

<BaseLayout {title} {description} {canonicalUrl}>
  <SiteHeader slot="header" />

  <HeroAdvantagesFlow>
    <Hero />
    <Advantages />
  </HeroAdvantagesFlow>

  {pageSections.map((section) => (
    section.id === HOME_SECTION_IDS.faq ? (
      <Faq />
    ) : (
      <PlaceholderSection id={section.id} title={section.title} />
    )
  ))}

  <ContactSection />

  <SiteFooter slot="footer" />
</BaseLayout>
