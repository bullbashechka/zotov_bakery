---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { CONTACTS, HOME_SECTION_IDS, getWhatsAppUrl } from '@/lib/site';
import '@/styles/global.css';

const title = 'ZOTOV bakery — десерты с характером';
const description = 'ZOTOV bakery — десерты, которые хочется разделить с близкими.';
const publicWebsiteUrl = import.meta.env.PUBLIC_WEBSITE_URL;
const canonicalUrl = publicWebsiteUrl
  ? new URL(Astro.url.pathname, publicWebsiteUrl).toString()
  : undefined;

const whatsappUrl = getWhatsAppUrl('general');

const pageSections = [
  { id: HOME_SECTION_IDS.advantages, title: 'Почему ZOTOV bakery' },
  { id: HOME_SECTION_IDS.honeyCake, title: 'Медовик' },
  { id: HOME_SECTION_IDS.assortment, title: 'Ассортимент' },
  { id: HOME_SECTION_IDS.whereToBuy, title: 'Где купить' },
  { id: HOME_SECTION_IDS.history, title: 'Наша история' },
  { id: HOME_SECTION_IDS.faq, title: 'Вопросы и ответы' },
  { id: HOME_SECTION_IDS.conversion, title: 'Выберите свой десерт' },
];
---

<BaseLayout {title} {description} {canonicalUrl}>
  <SiteHeader slot="header" />

  <Hero />

  {pageSections.map((section) => (
    <section id={section.id} class="section-anchor border-t border-ink/10 py-12">
      <div class="site-container">
        <h2 class="font-display text-3xl">{section.title}</h2>
      </div>
    </section>
  ))}

  <section id={HOME_SECTION_IDS.contacts} class="section-anchor border-t border-ink/10 py-12">
    <div class="site-container">
      <h2 class="font-display text-3xl">Контакты</h2>
      <div class="mt-5 flex flex-wrap gap-x-6 gap-y-3 text-muted">
        <a href={CONTACTS.bakery.href}>{CONTACTS.bakery.display}</a>
        <a href={CONTACTS.mobile.href}>{CONTACTS.mobile.display}</a>
      </div>
    </div>
  </section>

  <div slot="footer" class="border-t border-ink/10 py-8">
    <div class="site-container flex flex-wrap items-center justify-between gap-4 text-sm text-muted">
      <p>© {new Date().getFullYear()} ZOTOV bakery</p>
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a>
    </div>
  </div>
</BaseLayout>
