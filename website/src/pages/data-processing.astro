---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LegalPlaceholder from '@/components/LegalPlaceholder.astro';
import { getCanonicalUrl } from '@/lib/site-origin.mjs';

const canonicalUrl = getCanonicalUrl(import.meta.env.PUBLIC_WEBSITE_URL, Astro.url.pathname);
---

<BaseLayout
  title="Политика обработки данных"
  description="Временная страница политики обработки данных ZOTOV bakery."
  {canonicalUrl}
  robots="noindex,follow"
>
  <LegalPlaceholder title="Политика обработки данных" />
</BaseLayout>
