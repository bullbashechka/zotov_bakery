---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LegalPlaceholder from '@/components/LegalPlaceholder.astro';

const publicWebsiteUrl = import.meta.env.PUBLIC_WEBSITE_URL;
const canonicalUrl = publicWebsiteUrl
  ? new URL(Astro.url.pathname, publicWebsiteUrl).toString()
  : undefined;
---

<BaseLayout
  title="Политика обработки данных"
  description="Временная страница политики обработки данных ZOTOV bakery."
  {canonicalUrl}
  robots="noindex,follow"
>
  <LegalPlaceholder title="Политика обработки данных" />
</BaseLayout>
