{
  "name": "zotov-landing",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "workspaces": [
    "website"
  ],
  "scripts": {
    "dev": "bun run dev:website",
    "dev:website": "bun run --cwd website dev",
    "build": "bun run build:website",
    "build:website": "bun run --cwd website build",
    "typecheck": "bun run typecheck:website",
    "typecheck:website": "bun run --cwd website typecheck",
    "preview": "bun run --cwd website preview",
    "cf:dev": "bunx wrangler pages dev website/dist",
    "cf:deploy": "node scripts/security/release-deploy.mjs production",
    "cf:deploy:preview": "node scripts/security/release-deploy.mjs preview",
    "storybook": "bun run --cwd website storybook",
    "build:storybook": "bun run --cwd website build:storybook",
    "check:ui": "bun run --cwd website check:ui",
    "security:check": "node scripts/security/security-check.mjs",
    "release:check": "node scripts/security/release-check.mjs"
  },
  "devDependencies": {
    "parse5": "7.3.0",
    "playwright": "1.62.1",
    "wrangler": "4.124.0"
  },
  "overrides": {
    "devalue": "5.9.2",
    "fast-uri": "3.1.6",
    "js-yaml": "4.3.2",
    "sharp": "0.35.4",
    "svgo": "4.1.0"
  }
}
